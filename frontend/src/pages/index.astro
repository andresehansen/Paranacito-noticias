---
import Layout from '../layouts/Layout.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import NewsCard from '../components/NewsCard.astro';
import AdBanner from '../components/AdBanner.astro';
import { getCleanAndDeduplicatedNews } from '../utils/news';

// Cargar noticias 100% limpias y deduplicadas
const noticias = getCleanAndDeduplicatedNews();

const featuredNews = noticias[0];
const recentNews = noticias.slice(1);


const categoriasDestacadas = [
  { nombre: 'Todas', href: '/', count: noticias.length },
  { nombre: 'Río y Clima', href: '/categoria/rio-y-clima', count: noticias.filter(n => n.categoria === 'Río y Clima').length },
  { nombre: 'Comunidad', href: '/categoria/comunidad', count: noticias.filter(n => n.categoria === 'Comunidad').length },
  { nombre: 'Deportes', href: '/categoria/deportes', count: noticias.filter(n => n.categoria === 'Deportes').length },
  { nombre: 'Obras', href: '/categoria/obras-y-servicios', count: noticias.filter(n => n.categoria === 'Obras y Servicios').length },
  { nombre: 'Turismo', href: '/categoria/turismo-y-cultura', count: noticias.filter(n => n.categoria === 'Turismo y Cultura').length },
  { nombre: 'Sociedad', href: '/categoria/sociedad', count: noticias.filter(n => n.categoria === 'Sociedad').length },
];

---

<Layout>
  
  <!-- Widget Clima y Nivel del Río -->
  <WeatherWidget />

  <!-- Noticia Principal Destacada -->
  {featuredNews && (
    <section class="mb-10">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs uppercase tracking-wider text-slate-500 font-bold flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
          Noticia Destacada de Villa Paranacito
        </h2>
      </div>
      <NewsCard noticia={featuredNews} featured={true} />
    </section>
  )}

  <!-- Filtro Rápido de Secciones -->
  <section class="mb-8">
    <div class="flex items-center justify-between mb-3 border-b border-slate-200 pb-2">
      <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider">
        Últimas Noticias Locales
      </h3>
      <span class="text-xs text-slate-500">{noticias.length} notas publicadas</span>
    </div>

    <div class="flex items-center gap-2 overflow-x-auto pb-2">
      {categoriasDestacadas.map((cat) => (
        <a
          href={cat.href}
          class={`px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all ${
            cat.href === '/'
              ? 'bg-river-600 text-white shadow-sm shadow-river-600/30'
              : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-100'
          }`}
        >
          {cat.nombre} <span class="opacity-60 text-[10px]">({cat.count})</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Grilla de Noticias Recientes -->
  <section>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {recentNews.map((noticia) => (
        <NewsCard noticia={noticia} />
      ))}
    </div>
  </section>

  <!-- Espacio Publicitario / Google AdSense -->
  <AdBanner />


  <!-- Banner Comunitario de WhatsApp -->
  <section class="mt-14 bg-gradient-to-r from-emerald-800 to-teal-900 text-white rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-lg">
    <div class="max-w-xl">
      <span class="text-xs uppercase tracking-wider text-emerald-300 font-bold">Comunidad Isleña</span>
      <h3 class="text-xl md:text-2xl font-bold mt-1 mb-2">¿Querés difundir una noticia o evento de tu institución?</h3>
      <p class="text-sm text-emerald-100 leading-relaxed">
        Paranacito Noticias es un proyecto abierto para toda la comunidad. Podés compartir avisos del club, escuelas, talleres o alertas locales.
      </p>
    </div>
    <div class="shrink-0">
      <a
        href="https://api.whatsapp.com/send?phone=&text=Hola%2C%20quisiera%20enviar%20una%20novedad%20para%20Paranacito%20Noticias"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white text-emerald-900 hover:bg-emerald-50 font-bold text-sm shadow transition-colors"
      >
        <svg class="w-5 h-5 fill-[#25D366]" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>Enviar Novedad por WhatsApp</span>
      </a>
    </div>
  </section>

</Layout>
