---
import Layout from '../layouts/Layout.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import { getCleanAndDeduplicatedNews } from '../utils/news';

const noticias = getCleanAndDeduplicatedNews();

// Mapeo de perfiles de autor / fuente estilo Twitter
function getAuthorProfile(n: any) {
  const fuente = (n.fuente_nombre || n.fuentes_consultadas?.[0]?.nombre || '').toLowerCase();
  const titulo = (n.titulo || '').toLowerCase();
  const cat = n.categoria || 'Comunidad';

  if (fuente.includes('ceibas') || titulo.includes('ceibas')) {
    return { name: 'Ceibas Noticias', handle: '@ceibasnoticias', avatar: '🌲', color: 'bg-emerald-700 text-white', verified: true };
  }
  if (fuente.includes('bombero') || titulo.includes('bombero')) {
    return { name: 'Bomberos Voluntarios VP', handle: '@bomberos_vp', avatar: '🚒', color: 'bg-rose-600 text-white', verified: true };
  }
  if (fuente.includes('prefectura') || titulo.includes('prefectura') || titulo.includes('río') || cat === 'Río y Clima') {
    return { name: 'Prefectura & Hidrología', handle: '@prefectura_vp', avatar: '⚓', color: 'bg-sky-700 text-white', verified: true };
  }
  if (fuente.includes('hospital') || fuente.includes('salud') || cat === 'Salud y Educación') {
    return { name: 'Salud & Hospital VP', handle: '@salud_paranacito', avatar: '🏥', color: 'bg-teal-600 text-white', verified: true };
  }
  if (fuente.includes('polic') || fuente.includes('justicia') || fuente.includes('federal') || cat === 'Sociedad') {
    return { name: 'Seguridad & Juzgado', handle: '@seguridad_islas', avatar: '⚖️', color: 'bg-indigo-700 text-white', verified: true };
  }
  if (fuente.includes('islenos') || fuente.includes('isleno') || cat === 'Deportes') {
    return { name: 'Deportes del Delta', handle: '@islenos_club', avatar: '⚽', color: 'bg-emerald-600 text-white', verified: false };
  }
  if (fuente.includes('vialidad') || cat === 'Obras y Servicios') {
    return { name: 'Vialidad & Servicios', handle: '@vialidad_er', avatar: '🚜', color: 'bg-amber-600 text-white', verified: true };
  }
  if (fuente.includes('turismo') || cat === 'Turismo y Cultura') {
    return { name: 'Turismo Paranacito', handle: '@turismo_delta', avatar: '🎣', color: 'bg-cyan-700 text-white', verified: false };
  }
  if (fuente.includes('argentino') || fuente.includes('r2820') || fuente.includes('maxima') || fuente.includes('apf')) {
    const rawName = n.fuente_nombre?.split('/')[0]?.trim() || 'Prensa Regional';
    return { name: rawName, handle: '@prensa_regional', avatar: '📰', color: 'bg-slate-800 text-white', verified: true };
  }

  return { name: 'Paranacito Noticias', handle: '@paranacito_noticias', avatar: '🌊', color: 'bg-sky-600 text-white', verified: true };
}

// Fallbacks de imágenes temáticas de alta resolución representativas del Delta de Entre Ríos
const categoryFallbackImages: Record<string, string> = {
  'Río y Clima':      'https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=1200&q=80',
  'Comunidad':        'https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=1200&q=80',
  'Deportes':         'https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=1200&q=80',
  'Obras y Servicios':'https://images.unsplash.com/photo-1541888946425-d0fbb18086f6?auto=format&fit=crop&w=1200&q=80',
  'Salud y Educación':'https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=1200&q=80',
  'Turismo y Cultura':'https://images.unsplash.com/photo-1498654896293-37aacf113fd9?auto=format&fit=crop&w=1200&q=80',
  'Sociedad':         'https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=1200&q=80',
};

function getImage(n: any): string {
  if (n.imagen && typeof n.imagen === 'string' && (n.imagen.startsWith('http') || n.imagen.startsWith('/images/'))) {
    return n.imagen;
  }
  return categoryFallbackImages[n.categoria] || categoryFallbackImages['Comunidad'];
}

function getFuente(n: any): string {
  return n.fuente_nombre || (n.fuentes_consultadas?.[0]?.nombre) || 'Fuente regional';
}

function getFuenteUrl(n: any): string {
  return n.url_original || n.fuente_url || (n.fuentes_consultadas?.[0]?.url) || '';
}

function getParagraphs(n: any): string[] {
  if (Array.isArray(n.cuerpo) && n.cuerpo.length > 0) {
    return n.cuerpo.map((p: any) => String(p).trim()).filter(Boolean);
  }
  if (typeof n.cuerpo === 'string' && n.cuerpo.trim()) {
    return n.cuerpo.split('\n\n').map((p: string) => p.trim()).filter(Boolean);
  }
  const fallback = n.copete || n.resumen || '';
  return fallback ? [fallback] : [];
}

function tiempoRelativo(isoStr: string): string {
  if (!isoStr) return '';
  const ahora = Date.now();
  const fecha = new Date(isoStr).getTime();
  if (isNaN(fecha)) return '';
  const diffMin = Math.floor((ahora - fecha) / 60000);
  if (diffMin < 1) return 'ahora';
  if (diffMin < 60) return `${diffMin}m`;
  const diffHs = Math.floor(diffMin / 60);
  if (diffHs < 24) return `${diffHs}h`;
  const diffDias = Math.floor(diffHs / 24);
  return `${diffDias}d`;
}

const categorias = [
  { id: 'todas', nombre: '🔥 Todo', count: noticias.length },
  { id: 'Río y Clima', nombre: '🌊 Río', count: noticias.filter(n => n.categoria === 'Río y Clima').length },
  { id: 'Comunidad', nombre: '👥 Comunidad', count: noticias.filter(n => n.categoria === 'Comunidad').length },
  { id: 'Sociedad', nombre: '⚖️ Sociedad', count: noticias.filter(n => n.categoria === 'Sociedad').length },
  { id: 'Deportes', nombre: '⚽ Deportes', count: noticias.filter(n => n.categoria === 'Deportes').length },
  { id: 'Obras y Servicios', nombre: '🔧 Obras', count: noticias.filter(n => n.categoria === 'Obras y Servicios').length },
  { id: 'Salud y Educación', nombre: '🏥 Salud', count: noticias.filter(n => n.categoria === 'Salud y Educación').length },
  { id: 'Turismo y Cultura', nombre: '🎣 Turismo', count: noticias.filter(n => n.categoria === 'Turismo y Cultura').length },
];

const categoryBadges: Record<string, string> = {
  'Río y Clima':      'bg-sky-50 text-sky-700 border-sky-200',
  'Comunidad':        'bg-emerald-50 text-emerald-700 border-emerald-200',
  'Deportes':         'bg-amber-50 text-amber-700 border-amber-200',
  'Obras y Servicios':'bg-purple-50 text-purple-700 border-purple-200',
  'Salud y Educación':'bg-rose-50 text-rose-700 border-rose-200',
  'Turismo y Cultura':'bg-teal-50 text-teal-700 border-teal-200',
  'Sociedad':         'bg-indigo-50 text-indigo-700 border-indigo-200',
};

// Datos estructurados Schema.org JSON-LD para Google News
const structuredData = {
  "@context": "https://schema.org",
  "@type": "NewsMediaOrganization",
  "name": "Paranacito Noticias",
  "url": "https://paranacito-noticias.vercel.app",
  "logo": "https://paranacito-noticias.vercel.app/favicon.svg",
  "description": "Feed informativo en vivo de Villa Paranacito, Ceibas y el Delta Entrerriano.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Villa Paranacito",
    "addressRegion": "Entre Ríos",
    "addressCountry": "AR"
  }
};
---

<Layout title="Paranacito Noticias | Feed en Vivo del Delta" description="Feed de noticias de Villa Paranacito, Ceibas y el Delta Entrerriano. Información con profundidad y fuentes verificadas.">
  
  <!-- Inyección Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Widget Clima y Nivel del Río -->
  <WeatherWidget />

  <div class="max-w-2xl mx-auto">

    <!-- Encabezado del Feed estilo Twitter / Microblogging -->
    <div class="bg-white rounded-2xl border border-slate-200 p-4 mb-3 shadow-sm flex items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-sky-500 text-white flex items-center justify-center text-xl shadow-inner font-bold">
          🌊
        </div>
        <div>
          <h1 class="text-base font-extrabold text-slate-900 leading-tight">Feed en Vivo del Delta</h1>
          <p class="text-xs text-slate-500">Villa Paranacito, Ceibas e Islas del Ibicuy</p>
        </div>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Directo
        </span>
      </div>
    </div>

    <!-- Buscador en Vivo del Feed (Búsqueda instantánea estilo Twitter) -->
    <div class="relative mb-3">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <input
        type="search"
        id="feed-search-input"
        placeholder="🔍 Buscar en el Delta (ej: crecida, peaje, hospital, bomberos)..."
        class="w-full pl-10 pr-10 py-2.5 bg-white border border-slate-200 rounded-2xl text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent shadow-sm transition-all"
      />
      <button
        id="feed-search-clear"
        type="button"
        class="hidden absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 cursor-pointer font-bold text-sm"
        title="Limpiar búsqueda"
      >
        ✕
      </button>
    </div>

    <!-- Tabs de filtro estilo Twitter (Filtrado instantáneo en la misma página) -->
    <div class="sticky top-[68px] z-30 bg-slate-50/95 backdrop-blur py-2 -mx-2 px-2 mb-3">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none" id="cat-tabs">
        {categorias.map((cat, idx) => (
          <button
            type="button"
            class={`tab-btn flex-shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold transition-all cursor-pointer ${
              idx === 0
                ? 'active bg-slate-900 text-white shadow-sm'
                : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-100 hover:text-slate-900'
            }`}
            data-target-cat={cat.id}
          >
            {cat.nombre}
            {cat.count > 0 && <span class="ml-1 opacity-60 text-[11px]">({cat.count})</span>}
          </button>
        ))}
      </div>
    </div>

    <!-- Estado de Búsqueda sin Resultados -->
    <div id="no-search-results" class="hidden text-center py-12 px-4 bg-white rounded-2xl border border-slate-200 shadow-sm mb-4">
      <div class="text-3xl mb-2">🔍</div>
      <h3 class="text-sm font-bold text-slate-800">No se encontraron noticias coincidentes</h3>
      <p class="text-xs text-slate-500 mt-1">Probá buscando con otros términos como 'río', 'salud', 'camino' o 'puente'.</p>
    </div>

    <!-- Feed Timeline estilo Twitter con profundidad periodística y fotos completas -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm divide-y divide-slate-100 overflow-hidden" id="timeline">

      {noticias.map((n: any) => {
        const author = getAuthorProfile(n);
        const fuente = getFuente(n);
        const fuenteUrl = getFuenteUrl(n);
        const img = getImage(n);
        const tiempo = tiempoRelativo(n.fecha_iso || n.fecha_inicio_iso || '');
        const badgeStyle = categoryBadges[n.categoria] || 'bg-slate-50 text-slate-700 border-slate-200';
        const paragraphs = getParagraphs(n);
        const mainParagraphs = paragraphs.slice(0, 2);
        const extraParagraphs = paragraphs.slice(2);
        const hasExtra = extraParagraphs.length > 0;

        const wappShareMsg = encodeURIComponent(
          `📰 *${n.titulo}*\n\n${paragraphs[0] || n.resumen || n.copete}\n\n👉 Fuente: ${fuente}${fuenteUrl ? ` (${fuenteUrl})` : ''}\n📱 https://paranacito-noticias.vercel.app/`
        );

        return (
          <article
            class="tweet-card p-4 sm:p-5 hover:bg-slate-50/40 transition-colors"
            data-category={n.categoria}
            data-search-text={`${n.titulo} ${paragraphs.join(' ')} ${fuente} ${n.categoria}`.toLowerCase()}
          >
            <div class="flex items-start gap-3">
              
              <!-- Avatar estilo Twitter -->
              <div class={`w-10 h-10 rounded-full flex items-center justify-center text-lg shrink-0 shadow-sm font-semibold select-none ${author.color}`}>
                {author.avatar}
              </div>

              <!-- Contenedor principal del Post -->
              <div class="flex-1 min-w-0">

                <!-- Línea de Autor, Handle, Tiempo y Categoría -->
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <div class="flex items-center gap-1.5 min-w-0 flex-wrap">
                    <span class="font-bold text-slate-900 text-sm truncate">{author.name}</span>
                    {author.verified && (
                      <svg class="w-4 h-4 text-sky-500 shrink-0 fill-current" viewBox="0 0 24 24" title="Fuente Verificada">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                      </svg>
                    )}
                    <span class="text-xs text-slate-400 font-normal">{author.handle}</span>
                    {tiempo && (
                      <>
                        <span class="text-slate-300 text-xs">·</span>
                        <span class="text-xs text-slate-400">{tiempo}</span>
                      </>
                    )}
                  </div>

                  <div class="flex items-center gap-1.5 shrink-0">
                    {n.es_alerta && (
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-rose-600 text-white animate-pulse">
                        🚨 ALERTA
                      </span>
                    )}
                    <span class={`px-2 py-0.5 rounded-full text-[10px] font-bold border ${badgeStyle}`}>
                      {n.categoria}
                    </span>
                  </div>
                </div>

                <!-- Titular destacado (Directo en el feed, sin subpáginas) -->
                <h2 class="font-black text-slate-900 text-base sm:text-lg leading-snug mt-2 mb-2">
                  {n.titulo}
                </h2>

                <!-- Imagen Ilustrativa del Post (Estilo Media Card de Twitter) -->
                <div class="my-3 rounded-2xl overflow-hidden border border-slate-200/80 bg-slate-100 aspect-[16/9] relative shadow-sm group">
                  <img
                    src={img}
                    alt={n.titulo}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=1200&q=80';"
                  />
                  <span class="absolute bottom-2 left-2 px-2 py-0.5 bg-black/60 backdrop-blur-sm text-white text-[10px] font-bold rounded-md">
                    📸 {fuente}
                  </span>
                </div>

                <!-- Desarrollo y Profundidad Periodística (Párrafos principales) -->
                <div class="text-slate-700 text-sm leading-relaxed space-y-2.5 mt-2">
                  {mainParagraphs.map((p, idx) => (
                    <p class={idx === 0 ? "font-medium text-slate-800" : ""}>{p}</p>
                  ))}

                  <!-- Párrafos adicionales desplegables in-situ si la nota es larga -->
                  {hasExtra && (
                    <div class="extra-content hidden space-y-2.5 pt-1 border-t border-slate-100">
                      {extraParagraphs.map((p) => (
                        <p>{p}</p>
                      ))}
                    </div>
                  )}
                </div>

                <!-- Botón Desplegar más párrafos (si los hay) -->
                {hasExtra && (
                  <button
                    type="button"
                    class="btn-toggle-expand mt-2.5 inline-flex items-center gap-1 text-xs font-bold text-sky-600 hover:text-sky-800 transition-colors cursor-pointer py-1 px-2 -ml-2 rounded-lg hover:bg-sky-50"
                  >
                    <span class="toggle-text">📖 Leer desarrollo completo ({extraParagraphs.length} párrafos más) ▾</span>
                  </button>
                )}

                <!-- Barra de Acciones del Tweet -->
                <div class="flex items-center justify-between gap-2 mt-4 pt-3 border-t border-slate-100 text-xs text-slate-500">
                  
                  <!-- Link directo a la fuente externa original -->
                  {fuenteUrl ? (
                    <a
                      href={fuenteUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 font-semibold text-slate-600 hover:text-sky-600 transition-colors py-1 px-2 -ml-2 rounded-lg hover:bg-sky-50"
                      title={`Abrir nota original en ${fuente}`}
                    >
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                      <span class="truncate max-w-[150px] sm:max-w-[220px]">Fuente: {fuente}</span>
                    </a>
                  ) : (
                    <span class="text-slate-400">Fuente: {fuente}</span>
                  )}

                  <!-- Botones de Interacción -->
                  <div class="flex items-center gap-1.5">
                    
                    <!-- Botón Copiar Texto -->
                    <button
                      type="button"
                      class="btn-copy-tweet inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition-colors cursor-pointer"
                      data-copy={`${n.titulo}\n\n${paragraphs.join('\n\n')}\n\nFuente: ${fuente}`}
                      title="Copiar texto completo de la noticia"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                      </svg>
                      <span class="copy-text text-[11px] font-semibold">Copiar</span>
                    </button>

                    <!-- Botón Compartir en WhatsApp -->
                    <a
                      href={`https://api.whatsapp.com/send?text=${wappShareMsg}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white text-[11px] font-bold transition-all shadow-sm"
                      title="Compartir por WhatsApp"
                    >
                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                      </svg>
                      Compartir
                    </a>

                  </div>

                </div>

              </div>

            </div>
          </article>
        );
      })}

    </div>

  </div>

</Layout>

<script>
  // ── Interacciones del Feed: Filtro por Categorías + Buscador en Vivo ──────────
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const cards = document.querySelectorAll<HTMLElement>('.tweet-card');
  const searchInput = document.getElementById('feed-search-input') as HTMLInputElement | null;
  const searchClearBtn = document.getElementById('feed-search-clear');
  const noResultsEl = document.getElementById('no-search-results');

  let currentCategory = 'todas';
  let currentQuery = '';

  function normalizeSearch(str: string): string {
    return (str || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
  }

  function applyFilters() {
    let visibleCount = 0;
    const q = normalizeSearch(currentQuery);

    cards.forEach(card => {
      const cardCat = card.dataset.category || '';
      const cardText = normalizeSearch(card.dataset.searchText || '');

      const matchesCat = (currentCategory === 'todas' || cardCat === currentCategory);
      const matchesSearch = !q || cardText.includes(q);

      if (matchesCat && matchesSearch) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (noResultsEl) {
      if (visibleCount === 0) {
        noResultsEl.classList.remove('hidden');
      } else {
        noResultsEl.classList.add('hidden');
      }
    }
  }

  // Filtrado por Categorías
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => {
        b.classList.remove('active', 'bg-slate-900', 'text-white', 'shadow-sm');
        b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      });

      btn.classList.add('active', 'bg-slate-900', 'text-white', 'shadow-sm');
      btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');

      currentCategory = btn.dataset.targetCat || 'todas';
      applyFilters();
    });
  });

  // Buscador en Vivo
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      currentQuery = searchInput.value;
      if (searchClearBtn) {
        if (currentQuery.length > 0) {
          searchClearBtn.classList.remove('hidden');
        } else {
          searchClearBtn.classList.add('hidden');
        }
      }
      applyFilters();
    });
  }

  if (searchClearBtn && searchInput) {
    searchClearBtn.addEventListener('click', () => {
      searchInput.value = '';
      currentQuery = '';
      searchClearBtn.classList.add('hidden');
      applyFilters();
      searchInput.focus();
    });
  }

  // Botones para Desplegar Párrafos Extras In-Situ
  document.querySelectorAll<HTMLButtonElement>('.btn-toggle-expand').forEach(btn => {
    btn.addEventListener('click', () => {
      const article = btn.closest('article');
      if (!article) return;
      const extra = article.querySelector('.extra-content');
      const toggleText = btn.querySelector('.toggle-text');
      if (!extra || !toggleText) return;

      const isHidden = extra.classList.contains('hidden');
      if (isHidden) {
        extra.classList.remove('hidden');
        toggleText.textContent = '▴ Ocultar desarrollo completo';
      } else {
        extra.classList.add('hidden');
        toggleText.textContent = '📖 Leer desarrollo completo ▾';
      }
    });
  });

  // Botón Copiar Texto con Animación
  document.querySelectorAll<HTMLButtonElement>('.btn-copy-tweet').forEach(btn => {
    btn.addEventListener('click', async () => {
      const textToCopy = btn.dataset.copy || '';
      const textSpan = btn.querySelector('.copy-text');
      if (!textToCopy || !textSpan) return;

      try {
        await navigator.clipboard.writeText(textToCopy);
        const originalText = textSpan.textContent;
        textSpan.textContent = '¡Copiado! ✓';
        btn.classList.add('text-emerald-700', 'bg-emerald-50');

        setTimeout(() => {
          textSpan.textContent = originalText;
          btn.classList.remove('text-emerald-700', 'bg-emerald-50');
        }, 2000);
      } catch (err) {
        console.error('Error al copiar:', err);
      }
    });
  });
</script>
