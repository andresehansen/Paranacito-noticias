---
import Layout from '../layouts/Layout.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import { getCleanAndDeduplicatedNews } from '../utils/news';

const noticias = getCleanAndDeduplicatedNews();

// Categorías con conteo para el filtro por tabs
const categorias = [
  { id: 'todas', nombre: 'Todas', href: '/', count: noticias.length },
  { id: 'rio-y-clima', nombre: '🌊 Río', href: '/categoria/rio-y-clima', count: noticias.filter(n => n.categoria === 'Río y Clima').length },
  { id: 'comunidad', nombre: '👥 Comunidad', href: '/categoria/comunidad', count: noticias.filter(n => n.categoria === 'Comunidad').length },
  { id: 'sociedad', nombre: '⚖️ Sociedad', href: '/categoria/sociedad', count: noticias.filter(n => n.categoria === 'Sociedad').length },
  { id: 'deportes', nombre: '⚽ Deportes', href: '/categoria/deportes', count: noticias.filter(n => n.categoria === 'Deportes').length },
  { id: 'obras', nombre: '🔧 Obras', href: '/categoria/obras-y-servicios', count: noticias.filter(n => n.categoria === 'Obras y Servicios').length },
  { id: 'salud', nombre: '🏥 Salud', href: '/categoria/salud-y-educacion', count: noticias.filter(n => n.categoria === 'Salud y Educación').length },
  { id: 'turismo', nombre: '🎣 Turismo', href: '/categoria/turismo-y-cultura', count: noticias.filter(n => n.categoria === 'Turismo y Cultura').length },
];

const categoryColors: Record<string, string> = {
  'Río y Clima':      'bg-sky-100 text-sky-800 border-sky-200',
  'Comunidad':        'bg-emerald-100 text-emerald-800 border-emerald-200',
  'Deportes':         'bg-amber-100 text-amber-800 border-amber-200',
  'Obras y Servicios':'bg-purple-100 text-purple-800 border-purple-200',
  'Salud y Educación':'bg-rose-100 text-rose-800 border-rose-200',
  'Turismo y Cultura':'bg-teal-100 text-teal-800 border-teal-200',
  'Sociedad':         'bg-indigo-100 text-indigo-800 border-indigo-200',
};

const categoryFallback: Record<string, string> = {
  'Río y Clima':      'https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=900&q=80',
  'Comunidad':        'https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=900&q=80',
  'Deportes':         'https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=900&q=80',
  'Obras y Servicios':'https://images.unsplash.com/photo-1541888946425-d0fbb18086f6?auto=format&fit=crop&w=900&q=80',
  'Salud y Educación':'https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=900&q=80',
  'Turismo y Cultura':'https://images.unsplash.com/photo-1498654896293-37aacf113fd9?auto=format&fit=crop&w=900&q=80',
  'Sociedad':         'https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=900&q=80',
};

function getResumen(n: any): string {
  return n.resumen || n.copete || '';
}

function getFuente(n: any): string {
  return n.fuente_nombre || (n.fuentes_consultadas?.[0]?.nombre) || 'Fuente regional';
}

function getFuenteUrl(n: any): string {
  return n.url_original || n.fuente_url || (n.fuentes_consultadas?.[0]?.url) || '#';
}

function tiempoRelativo(isoStr: string): string {
  if (!isoStr) return '';
  const ahora = Date.now();
  const fecha = new Date(isoStr).getTime();
  const diff = Math.floor((ahora - fecha) / 60000); // minutos
  if (diff < 60) return `hace ${diff} min`;
  if (diff < 1440) return `hace ${Math.floor(diff / 60)} hs`;
  return `hace ${Math.floor(diff / 1440)} días`;
}
---

<Layout title="Paranacito Noticias | Feed del Delta" description="Últimas noticias de Villa Paranacito, Ceibas e Islas del Ibicuy.">
  
  <!-- Widget Clima y Nivel del Río -->
  <WeatherWidget />

  <!-- Filtro de categorías — sticky tabs -->
  <div class="sticky top-[72px] z-30 bg-white/95 backdrop-blur border-b border-slate-200 -mx-4 px-4 mb-6">
    <div class="flex items-center gap-1.5 overflow-x-auto py-2 scrollbar-none max-w-2xl mx-auto">
      {categorias.map(cat => (
        <a
          href={cat.href}
          class="flex-shrink-0 px-3 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap transition-all
                 bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 hover:border-slate-300"
          data-cat={cat.id}
        >
          {cat.nombre}
          {cat.count > 0 && <span class="ml-1 opacity-50 text-[10px]">({cat.count})</span>}
        </a>
      ))}
    </div>
  </div>

  <!-- Feed de posts -->
  <div class="max-w-2xl mx-auto space-y-4" id="feed">

    {noticias.map((n: any) => {
      const resumen = getResumen(n);
      const fuente = getFuente(n);
      const fuenteUrl = getFuenteUrl(n);
      const badgeClass = categoryColors[n.categoria] || 'bg-slate-100 text-slate-800 border-slate-200';
      const imgSrc = (n.imagen && n.imagen.startsWith('http')) ? n.imagen : (categoryFallback[n.categoria] || categoryFallback['Comunidad']);
      const tiempo = tiempoRelativo(n.fecha_iso || n.fecha_inicio_iso || '');
      const wappText = encodeURIComponent(
        `📰 *${n.titulo}*\n${resumen}\n\n👉 Ver más en: https://paranacito-noticias.vercel.app/noticias/${n.slug}`
      );

      return (
        <article
          class="bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-sm hover:shadow-md transition-all duration-200"
          data-categoria={n.categoria}
        >
          <!-- Imagen -->
          <a href={`/noticias/${n.slug}`} class="block relative aspect-[16/9] overflow-hidden bg-slate-200">
            <img
              src={imgSrc}
              alt={n.titulo}
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
              onerror={`this.onerror=null;this.src='${categoryFallback[n.categoria] || categoryFallback["Comunidad"]}';`}
            />
            <!-- Categoría badge -->
            <span class={`absolute top-3 left-3 px-2.5 py-0.5 rounded-full text-xs font-semibold border shadow-sm ${badgeClass}`}>
              {n.categoria}
            </span>
            <!-- Badge ALERTA -->
            {n.es_alerta && (
              <span class="absolute top-3 right-3 px-2 py-0.5 rounded-full text-[11px] font-black bg-rose-600 text-white shadow animate-pulse">
                🚨 ALERTA
              </span>
            )}
          </a>

          <!-- Contenido del post -->
          <div class="p-4">
            <!-- Título -->
            <a href={`/noticias/${n.slug}`}>
              <h2 class="font-bold text-slate-900 leading-snug mb-2 text-[15px] hover:text-river-600 transition-colors line-clamp-3">
                {n.titulo}
              </h2>
            </a>

            <!-- Resumen (2-3 oraciones) -->
            {resumen && (
              <p class="text-slate-600 text-sm leading-relaxed mb-3 line-clamp-3">
                {resumen}
              </p>
            )}

            <!-- Pie: fuente + tiempo + WhatsApp -->
            <div class="flex items-center justify-between gap-2 pt-2.5 border-t border-slate-100">
              <div class="flex items-center gap-2 min-w-0">
                <!-- Fuente con link externo -->
                <a
                  href={fuenteUrl !== '#' ? fuenteUrl : undefined}
                  target={fuenteUrl !== '#' ? '_blank' : undefined}
                  rel="noopener noreferrer"
                  class="text-xs text-slate-500 font-medium hover:text-river-600 transition-colors truncate max-w-[160px]"
                  title={`Fuente: ${fuente}`}
                >
                  📰 {fuente}
                </a>
                {tiempo && (
                  <span class="text-[11px] text-slate-400 whitespace-nowrap flex-shrink-0">· {tiempo}</span>
                )}
              </div>

              <!-- Botón WhatsApp -->
              <a
                href={`https://api.whatsapp.com/send?text=${wappText}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-shrink-0 inline-flex items-center gap-1 rounded-lg bg-[#25D366] text-white hover:bg-[#20bd5a] transition-colors shadow-sm px-2.5 py-1 text-xs"
                title="Compartir por WhatsApp"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
                Compartir
              </a>
            </div>
          </div>
        </article>
      );
    })}

    {noticias.length === 0 && (
      <div class="text-center py-16 text-slate-400">
        <div class="text-4xl mb-3">📭</div>
        <p class="font-medium">No hay noticias publicadas aún.</p>
      </div>
    )}
  </div>

</Layout>
