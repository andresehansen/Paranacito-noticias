---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';

export async function getStaticPaths() {
  const newsFiles = import.meta.glob('../../../../data/noticias/*.json', { eager: true });
  const allNoticias = Object.values(newsFiles)
    .map((file: any) => file.default || file)
    .filter((n: any) => n && n.slug && n.publicado !== false);

  allNoticias.sort((a: any, b: any) => 
    String(b.fecha_iso || b.fecha_inicio_iso || '').localeCompare(String(a.fecha_iso || a.fecha_inicio_iso || ''))
  );

  const categoriesMap = [
    { cat: 'rio-y-clima', nombre: 'Río y Clima', desc: 'Monitoreo de la altura del Río Paranacito, alertas hidrológicas y pronóstico del tiempo.' },
    { cat: 'comunidad', nombre: 'Comunidad', desc: 'Novedades de vecinos, bomberos voluntarios, escuelas e instituciones de Villa Paranacito.' },
    { cat: 'deportes', nombre: 'Deportes', desc: 'Actividades del Club Isleños Independientes, fútbol local, náutica y torneos del Delta.' },
    { cat: 'obras-y-servicios', nombre: 'Obras y Servicios', desc: 'Estado del camino de acceso, mejoras viales, alumbrado y servicios esenciales.' },
    { cat: 'turismo-y-cultura', nombre: 'Turismo y Cultura', desc: 'Pesca deportiva, gastronomía de islas, reservas en cabañas y eventos del Delta.' },
    { cat: 'salud-y-educacion', nombre: 'Salud y Educación', desc: 'Operativos de la lancha sanitaria, vacunación y novedades del Hospital y escuelas.' },
    { cat: 'sociedad', nombre: 'Sociedad', desc: 'Crónicas y noticias generales de interés departamental y provincial.' }
  ];

  return categoriesMap.map((c) => ({
    params: { cat: c.cat },
    props: {
      nombre: c.nombre,
      descripcion: c.desc,
      noticiasCat: allNoticias.filter((n: any) => (n.categoria || '').toLowerCase().trim() === c.nombre.toLowerCase().trim())
    }
  }));
}


const { nombre, descripcion, noticiasCat } = Astro.props;
---

<Layout
  title={`${nombre} | Paranacito Noticias`}
  description={descripcion}
>
  <!-- Encabezado de Categoría -->
  <header class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 mb-8 shadow-sm">
    <nav class="text-xs text-slate-500 mb-2">
      <a href="/" class="hover:text-slate-800">Inicio</a> / <span class="text-slate-700 font-medium">Categorías</span>
    </nav>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-2">
      {nombre}
    </h1>
    <p class="text-slate-600 text-sm max-w-2xl leading-relaxed">
      {descripcion}
    </p>
    <div class="mt-4 text-xs font-semibold text-river-600">
      {noticiasCat.length} {noticiasCat.length === 1 ? 'noticia disponible' : 'noticias disponibles'}
    </div>
  </header>

  <!-- Grilla de Noticias -->
  {noticiasCat.length > 0 ? (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {noticiasCat.map((noticia: any) => (
        <NewsCard noticia={noticia} />
      ))}
    </div>
  ) : (
    <div class="bg-white border border-slate-200 rounded-2xl p-12 text-center text-slate-500">
      <div class="text-3xl mb-2">📰</div>
      <p class="text-sm font-medium">No hay noticias registradas en esta sección por el momento.</p>
      <a href="/" class="inline-block mt-4 text-xs text-river-600 font-bold hover:underline">
        &larr; Volver a la portada principal
      </a>
    </div>
  )}

</Layout>
