---
import Layout from '../../layouts/Layout.astro';
import { getCleanAndDeduplicatedNews } from '../../utils/news';

export async function getStaticPaths() {
  const allNoticias = getCleanAndDeduplicatedNews();

  const categoriesMap = [
    { cat: 'rio-y-clima', nombre: 'Río y Clima', emoji: '🌊', desc: 'Monitoreo del Río Paranacito, alertas hidrológicas y pronóstico del tiempo.' },
    { cat: 'comunidad', nombre: 'Comunidad', emoji: '👥', desc: 'Novedades de vecinos, bomberos voluntarios, escuelas e instituciones de Villa Paranacito.' },
    { cat: 'deportes', nombre: 'Deportes', emoji: '⚽', desc: 'Club Isleños Independientes, fútbol local, náutica y torneos del Delta.' },
    { cat: 'obras-y-servicios', nombre: 'Obras y Servicios', emoji: '🔧', desc: 'Estado del camino de acceso, mejoras viales, alumbrado y servicios esenciales.' },
    { cat: 'turismo-y-cultura', nombre: 'Turismo y Cultura', emoji: '🎣', desc: 'Pesca deportiva, gastronomía de islas, reservas en cabañas y eventos del Delta.' },
    { cat: 'salud-y-educacion', nombre: 'Salud y Educación', emoji: '🏥', desc: 'Operativos de la lancha sanitaria, vacunación y novedades del Hospital y escuelas.' },
    { cat: 'sociedad', nombre: 'Sociedad', emoji: '⚖️', desc: 'Crónicas y noticias generales de interés departamental y provincial.' },
  ];

  return categoriesMap.map((c) => ({
    params: { cat: c.cat },
    props: {
      nombre: c.nombre,
      emoji: c.emoji,
      descripcion: c.desc,
      noticiasCat: allNoticias.filter((n: any) =>
        (n.categoria || '').toLowerCase().trim() === c.nombre.toLowerCase().trim()
      )
    }
  }));
}

const { nombre, emoji, descripcion, noticiasCat } = Astro.props;

const categoryColors: Record<string, string> = {
  'Río y Clima':      'bg-sky-100 text-sky-800 border-sky-200',
  'Comunidad':        'bg-emerald-100 text-emerald-800 border-emerald-200',
  'Deportes':         'bg-amber-100 text-amber-800 border-amber-200',
  'Obras y Servicios':'bg-purple-100 text-purple-800 border-purple-200',
  'Salud y Educación':'bg-rose-100 text-rose-800 border-rose-200',
  'Turismo y Cultura':'bg-teal-100 text-teal-800 border-teal-200',
  'Sociedad':         'bg-indigo-100 text-indigo-800 border-indigo-200',
};

const categoryFallback: Record<string, string> = {
  'Río y Clima':      'https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=900&q=80',
  'Comunidad':        'https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=900&q=80',
  'Deportes':         'https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=900&q=80',
  'Obras y Servicios':'https://images.unsplash.com/photo-1541888946425-d0fbb18086f6?auto=format&fit=crop&w=900&q=80',
  'Salud y Educación':'https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=900&q=80',
  'Turismo y Cultura':'https://images.unsplash.com/photo-1498654896293-37aacf113fd9?auto=format&fit=crop&w=900&q=80',
  'Sociedad':         'https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=900&q=80',
};

function getResumen(n: any): string { return n.resumen || n.copete || ''; }
function getFuente(n: any): string { return n.fuente_nombre || n.fuentes_consultadas?.[0]?.nombre || 'Fuente regional'; }
function getFuenteUrl(n: any): string { return n.url_original || n.fuente_url || n.fuentes_consultadas?.[0]?.url || '#'; }
---

<Layout title={`${emoji} ${nombre} | Paranacito Noticias`} description={descripcion}>
  <div class="max-w-2xl mx-auto">

    <!-- Breadcrumb -->
    <nav class="text-xs text-slate-400 mb-4 flex items-center gap-1.5">
      <a href="/" class="hover:text-river-600 transition-colors">Inicio</a>
      <span>›</span>
      <span class="text-slate-600">{emoji} {nombre}</span>
    </nav>

    <!-- Header de categoría -->
    <header class="mb-6 pb-4 border-b border-slate-200">
      <h1 class="text-lg font-black text-slate-900">{emoji} {nombre}</h1>
      <p class="text-xs text-slate-500 mt-0.5">{noticiasCat.length} nota{noticiasCat.length !== 1 ? 's' : ''} · {descripcion}</p>
    </header>

    <!-- Feed de posts de la categoría -->
    <div class="space-y-4">
      {noticiasCat.map((n: any) => {
        const resumen = getResumen(n);
        const fuente = getFuente(n);
        const fuenteUrl = getFuenteUrl(n);
        const badgeClass = categoryColors[n.categoria] || 'bg-slate-100 text-slate-800 border-slate-200';
        const imgSrc = (n.imagen && n.imagen.startsWith('http')) ? n.imagen : (categoryFallback[n.categoria] || categoryFallback['Comunidad']);
        const wappText = encodeURIComponent(`📰 *${n.titulo}*\n${resumen}\n\n👉 https://paranacito-noticias.vercel.app/noticias/${n.slug}`);

        return (
          <article class="bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-sm hover:shadow-md transition-all duration-200">
            <a href={`/noticias/${n.slug}`} class="block relative aspect-[16/9] overflow-hidden bg-slate-200">
              <img
                src={imgSrc}
                alt={n.titulo}
                loading="lazy"
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                onerror={`this.onerror=null;this.src='${categoryFallback[n.categoria] || categoryFallback["Comunidad"]}';`}
              />
              <span class={`absolute top-3 left-3 px-2.5 py-0.5 rounded-full text-xs font-semibold border shadow-sm ${badgeClass}`}>{n.categoria}</span>
              {n.es_alerta && <span class="absolute top-3 right-3 px-2 py-0.5 rounded-full text-[11px] font-black bg-rose-600 text-white shadow animate-pulse">🚨 ALERTA</span>}
            </a>
            <div class="p-4">
              <a href={`/noticias/${n.slug}`}>
                <h2 class="font-bold text-slate-900 leading-snug mb-2 text-[15px] hover:text-river-600 transition-colors line-clamp-3">{n.titulo}</h2>
              </a>
              {resumen && <p class="text-slate-600 text-sm leading-relaxed mb-3 line-clamp-3">{resumen}</p>}
              <div class="flex items-center justify-between gap-2 pt-2.5 border-t border-slate-100">
                <a href={fuenteUrl !== '#' ? fuenteUrl : undefined} target={fuenteUrl !== '#' ? '_blank' : undefined} rel="noopener noreferrer" class="text-xs text-slate-500 font-medium hover:text-river-600 transition-colors truncate max-w-[160px]">
                  📰 {fuente}
                </a>
                <a href={`https://api.whatsapp.com/send?text=${wappText}`} target="_blank" rel="noopener noreferrer" class="flex-shrink-0 inline-flex items-center gap-1 rounded-lg bg-[#25D366] text-white hover:bg-[#20bd5a] transition-colors shadow-sm px-2.5 py-1 text-xs">
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                  Compartir
                </a>
              </div>
            </div>
          </article>
        );
      })}

      {noticiasCat.length === 0 && (
        <div class="text-center py-16 text-slate-400">
          <div class="text-4xl mb-3">📭</div>
          <p class="font-medium">No hay noticias en esta categoría aún.</p>
        </div>
      )}
    </div>

    <div class="mt-8 text-center">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-river-600 hover:text-river-800 transition-colors">
        ← Volver al feed
      </a>
    </div>
  </div>
</Layout>
