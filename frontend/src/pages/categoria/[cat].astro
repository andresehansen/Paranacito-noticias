---
import { getCleanAndDeduplicatedNews } from '../../utils/news';

export async function getStaticPaths() {
  const categoriesMap = [
    { cat: 'rio-y-clima' },
    { cat: 'comunidad' },
    { cat: 'deportes' },
    { cat: 'obras-y-servicios' },
    { cat: 'turismo-y-cultura' },
    { cat: 'salud-y-educacion' },
    { cat: 'sociedad' }
  ];

  return categoriesMap.map((c) => ({
    params: { cat: c.cat }
  }));
}
---

