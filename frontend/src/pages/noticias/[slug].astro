---
import { getCleanAndDeduplicatedNews } from '../../utils/news';

export async function getStaticPaths() {
  const allNoticias = getCleanAndDeduplicatedNews();
  return allNoticias.map((noticia: any) => ({
    params: { slug: noticia.slug },
    props: { noticia }
  }));
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0;url=/" />
    <title>Redirigiendo a Paranacito Noticias...</title>
    <script>
      window.location.replace('/');
    </script>
  </head>
  <body class="bg-slate-50 flex items-center justify-center min-h-screen text-slate-600 font-sans text-sm">
    <p>Redirigiendo al feed principal... <a href="/" class="text-sky-600 font-bold underline">Hacé clic aquí si no redirige</a></p>
  </body>
</html>
