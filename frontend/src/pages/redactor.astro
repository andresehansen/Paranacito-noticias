---
import Layout from '../layouts/Layout.astro';
import { getCleanAndDeduplicatedNews } from '../utils/news';

// Cargar todas las noticias completas y deduplicadas
const allNews = getCleanAndDeduplicatedNews();
const serverGeminiKey = import.meta.env.PUBLIC_GEMINI_API_KEY || import.meta.env.GEMINI_API_KEY || '';

export const prerender = true;
---

<Layout title="Mesa de Redacción | Paranacito Noticias" description="Panel privado de administración.">
  <head slot="head">
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
  </head>

  <!-- ══════════════════════════════════════════════════════════════ -->
  <!-- PANTALLA DE LOGIN                                               -->
  <!-- ══════════════════════════════════════════════════════════════ -->
  <div id="auth-screen" class="min-h-screen flex items-center justify-center p-4 bg-slate-50">
    <div class="w-full max-w-sm bg-white rounded-3xl border border-slate-200 shadow-xl p-8 space-y-5">
      <div class="text-center">
        <div class="w-14 h-14 bg-slate-900 text-white rounded-2xl flex items-center justify-center text-2xl mx-auto mb-3">✍️</div>
        <h2 class="text-xl font-extrabold text-slate-900">Mesa de Redacción</h2>
        <p class="text-xs text-slate-500 mt-1">Paranacito Noticias — Panel privado</p>
      </div>

      <div class="space-y-3">
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">PIN de acceso</label>
          <input type="password" id="input-pin" placeholder="••••" maxlength="20" autocomplete="current-password"
            class="w-full text-center text-2xl font-mono tracking-widest bg-slate-50 border border-slate-300 rounded-xl py-3 px-4 focus:ring-2 focus:ring-sky-500 focus:outline-none" />
        </div>

        <button id="btn-login" type="button"
          class="w-full py-3.5 bg-sky-600 hover:bg-sky-700 text-white font-bold text-sm rounded-xl shadow transition-colors cursor-pointer">
          Entrar al Panel
        </button>
        <p id="login-error" class="hidden text-xs text-rose-600 font-semibold text-center pt-1">PIN incorrecto.</p>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════════ -->
  <!-- PANEL PRINCIPAL                                                 -->
  <!-- ══════════════════════════════════════════════════════════════ -->
  <div id="main-panel" class="hidden min-h-screen bg-slate-50">

    <!-- Barra superior -->
    <header class="sticky top-0 z-30 bg-white border-b border-slate-200 px-4 py-3 flex items-center justify-between gap-3 shadow-sm">
      <div class="flex items-center gap-2">
        <span class="text-lg">✍️</span>
        <span class="font-extrabold text-slate-900 text-sm sm:text-base">Mesa de Redacción</span>
      </div>
      <div class="flex items-center gap-2">
        <button id="btn-change-pin" class="text-[11px] text-slate-500 hover:text-slate-800 px-2.5 py-1.5 rounded-lg bg-slate-100 cursor-pointer transition-colors">⚙️ PIN</button>
        <button id="btn-logout" class="text-[11px] font-semibold text-rose-600 px-2.5 py-1.5 rounded-lg bg-rose-50 cursor-pointer transition-colors">Salir</button>
      </div>
    </header>

    <!-- Tabs de navegación -->
    <nav class="sticky top-[57px] z-20 bg-white border-b border-slate-200 px-4 flex gap-1 pt-2">
      <button id="tab-crear" class="tab-btn px-4 py-2.5 text-xs sm:text-sm font-bold rounded-t-xl border-b-2 border-sky-600 text-sky-700 bg-sky-50 transition-all cursor-pointer">✨ Crear con IA</button>
      <button id="tab-admin" class="tab-btn px-4 py-2.5 text-xs sm:text-sm font-bold rounded-t-xl border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition-all cursor-pointer">
        📰 Notas <span id="badge-total" class="ml-1 bg-slate-200 text-slate-600 text-[10px] px-1.5 py-0.5 rounded-full">{allNews.length}</span>
      </button>
    </nav>

    <main class="max-w-5xl mx-auto px-3 sm:px-6 py-6 space-y-6">

      <!-- ══════════════════════ TAB CREAR ══════════════════════════ -->
      <div id="view-crear" class="space-y-5">

        <!-- Clave Gemini -->
        <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
          <div class="flex items-center justify-between mb-2">
            <label class="text-xs font-bold text-slate-600 uppercase tracking-wider">🔑 Clave Gemini API</label>
            <span id="gemini-status" class="text-[10px] font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full">Sin configurar</span>
          </div>
          <input type="password" id="gemini-key" placeholder="Pegá tu clave de Google AI Studio"
            class="w-full text-xs font-mono bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-sky-500 focus:outline-none" />
          <p class="text-[10px] text-slate-400 mt-1.5">Se guarda en este dispositivo. Conseguí una gratis en <a href="https://aistudio.google.com/app/apikey" target="_blank" class="text-sky-600 underline">aistudio.google.com</a></p>
        </div>

        <!-- Formulario de creación -->
        <div class="bg-white rounded-2xl border border-slate-200 p-4 sm:p-6 shadow-sm space-y-4">
          <h2 class="text-sm font-extrabold text-slate-800">Nueva Noticia con IA</h2>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">Categoría</label>
              <select id="categoria-select" class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-sky-500 focus:outline-none font-medium">
                <option value="Río y Clima">Río y Clima</option>
                <option value="Comunidad" selected>Comunidad</option>
                <option value="Obras y Servicios">Obras y Servicios</option>
                <option value="Deportes">Deportes</option>
                <option value="Salud y Educación">Salud y Educación</option>
                <option value="Turismo y Cultura">Turismo y Cultura</option>
                <option value="Sociedad">Sociedad</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">Confiabilidad</label>
              <select id="confiabilidad-select" class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-sky-500 focus:outline-none font-medium">
                <option value="Alta">🟢 Alta</option>
                <option value="Media" selected>🟡 Media</option>
                <option value="Baja">🔴 Baja</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">Fuente / Origen</label>
            <input type="text" id="fuente-nombre" value="Reporte Comunitario"
              class="w-full text-sm bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-sky-500 focus:outline-none" />
          </div>

          <div class="flex items-center justify-between p-3 bg-rose-50 border border-rose-200 rounded-xl">
            <div>
              <p class="text-xs font-bold text-rose-900">🚨 ¿Alerta Urgente?</p>
              <p class="text-[11px] text-rose-700">Banner rojo pulsante en portada</p>
            </div>
            <input type="checkbox" id="es-alerta" class="w-5 h-5 text-rose-600 rounded cursor-pointer" />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">📸 Capturas de posteos en redes (opcional)</label>
            <p class="text-[11px] text-slate-400 mb-1.5">Subí hasta 4 capturas de Facebook, Instagram o WhatsApp. Gemini lee el texto de la imagen, lo usa como fuente y la primera captura queda como foto de portada real de la noticia.</p>
            <input type="file" id="captura-input" accept="image/*" multiple
              class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-sky-500 focus:outline-none file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-sky-600 file:text-white file:text-xs file:font-bold file:cursor-pointer cursor-pointer" />
            <div id="captura-preview" class="hidden mt-2 flex gap-2 flex-wrap"></div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">📝 Información bruta a redactar</label>
            <textarea id="raw-text" rows="5"
              placeholder="Ej: Hay alerta hidrométrica en el Río Paranacito. Nivel esperado 2.10 mts esta noche por sudestada... (opcional si ya subiste una captura)"
              class="w-full text-sm text-slate-800 bg-slate-50 border border-slate-300 rounded-xl p-3.5 focus:ring-2 focus:ring-sky-500 focus:outline-none leading-relaxed resize-none"></textarea>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">🖼️ URL de foto (opcional)</label>
            <input type="url" id="imagen-url" placeholder="Dejalo vacío → usa la captura subida, o una foto temática automática"
              class="w-full text-xs font-mono bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-sky-500 focus:outline-none" />
          </div>

          <button id="btn-generar" type="button"
            class="w-full py-4 bg-gradient-to-r from-sky-600 to-teal-600 hover:from-sky-700 hover:to-teal-700 text-white font-bold text-sm rounded-xl shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer">
            <span id="btn-icon">✨</span>
            <span id="btn-text">Redactar con Gemini 2.5</span>
          </button>
          <p id="create-error" class="hidden text-xs text-rose-600 font-semibold p-3 bg-rose-50 rounded-xl border border-rose-200"></p>
        </div>

        <!-- Preview generado -->
        <div id="preview-container" class="hidden space-y-4">

          <!-- Aviso de posible repetido -->
          <div id="dup-warning" class="hidden bg-amber-50 border border-amber-300 rounded-xl p-3.5 text-xs text-amber-900 space-y-2">
            <p class="font-bold">⚠️ Posible noticia repetida</p>
            <p>Ya existe una nota parecida publicada: "<span id="dup-title" class="font-semibold"></span>" (<span id="dup-pct"></span>% de coincidencia de contenido).</p>
            <label class="flex items-center gap-2 font-semibold cursor-pointer">
              <input type="checkbox" id="dup-override" class="w-4 h-4 cursor-pointer" />
              Publicar de todas formas (es una actualización o es un hecho distinto)
            </label>
          </div>

          <!-- Aviso de relevancia -->
          <div id="relevance-warning" class="hidden bg-rose-50 border border-rose-300 rounded-xl p-3.5 text-xs text-rose-900">
            <p class="font-bold">🚫 No parece tener a Villa Paranacito como protagonista</p>
            <p id="relevance-motivo" class="mt-1"></p>
          </div>

          <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-4">
            <div class="flex items-center gap-2 flex-wrap">
              <span id="prev-cat" class="text-xs font-bold px-3 py-0.5 rounded-full bg-sky-100 text-sky-800 border border-sky-200"></span>
              <span id="prev-alert-badge" class="hidden text-xs font-black px-3 py-0.5 rounded-full bg-rose-600 text-white animate-pulse">🚨 ALERTA</span>
            </div>
            <h3 id="prev-titulo" class="text-xl font-extrabold text-slate-900 leading-tight"></h3>
            <p id="prev-copete" class="text-sm text-slate-700 font-medium bg-slate-50 p-3 rounded-xl border-l-4 border-sky-500"></p>
            <div id="prev-imagen-wrap" class="rounded-xl overflow-hidden aspect-video bg-slate-100">
              <img id="prev-imagen" src="" alt="" class="w-full h-full object-cover" />
            </div>
            <div id="prev-cuerpo" class="text-sm text-slate-700 leading-relaxed space-y-3"></div>
          </div>

          <!-- WhatsApp -->
          <div class="bg-gradient-to-r from-emerald-600 to-green-700 text-white rounded-2xl p-4 shadow-md">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold uppercase tracking-wider">💬 Texto para WhatsApp</span>
              <button id="btn-copy-wa" class="text-xs bg-white text-emerald-800 font-bold px-3 py-1 rounded-lg cursor-pointer">Copiar</button>
            </div>
            <pre id="prev-wa" class="text-xs bg-black/20 p-3 rounded-xl whitespace-pre-wrap font-sans leading-relaxed"></pre>
          </div>

          <!-- Publicar -->
          <div class="bg-slate-900 text-white rounded-2xl p-5 shadow-md">
            <p class="text-sm font-bold mb-1">Publicar en Paranacito Noticias</p>
            <p class="text-xs text-slate-400 mb-4">Publicación directa — sin descargar archivos.</p>
            <button id="btn-publish"
              class="w-full py-3.5 bg-sky-600 hover:bg-sky-500 font-bold text-sm rounded-xl transition-colors flex items-center justify-center gap-2 cursor-pointer shadow">
              <span id="pub-icon">🚀</span>
              <span id="pub-label">Publicar Noticia</span>
            </button>
          </div>
        </div>

      </div><!-- /view-crear -->

      <!-- ══════════════════════ TAB ADMINISTRAR ═══════════════════ -->
      <div id="view-admin" class="hidden space-y-4">

        <!-- Barra de búsqueda y filtro -->
        <div class="flex gap-2 flex-col sm:flex-row">
          <input type="text" id="search-input" placeholder="🔍 Buscar noticia..."
            class="flex-1 text-sm bg-white border border-slate-300 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-sky-500 focus:outline-none shadow-sm" />
          <select id="cat-filter" class="text-xs bg-white border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-sky-500 focus:outline-none shadow-sm font-medium">
            <option value="">Todas las categorías</option>
            <option value="Río y Clima">Río y Clima</option>
            <option value="Comunidad">Comunidad</option>
            <option value="Obras y Servicios">Obras y Servicios</option>
            <option value="Deportes">Deportes</option>
            <option value="Salud y Educación">Salud y Educación</option>
            <option value="Turismo y Cultura">Turismo y Cultura</option>
            <option value="Sociedad">Sociedad</option>
          </select>
        </div>

        <!-- Lista de noticias -->
        <div id="news-list" class="space-y-3"></div>

      </div><!-- /view-admin -->

    </main>
  </div>

  <!-- ══════════════════════════════════════════════════════════════ -->
  <!-- DRAWER DE EDICIÓN (bottom sheet, mobile-friendly)              -->
  <!-- ══════════════════════════════════════════════════════════════ -->
  <div id="edit-drawer" class="fixed inset-0 z-50 hidden">
    <div id="drawer-overlay" class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"></div>
    <div class="absolute bottom-0 left-0 right-0 bg-white rounded-t-3xl shadow-2xl max-h-[95vh] overflow-y-auto flex flex-col">
      <!-- Handle / Header -->
      <div class="flex items-center justify-between px-5 pt-5 pb-3 border-b border-slate-100 sticky top-0 bg-white z-10">
        <div class="w-10 h-1 bg-slate-300 rounded-full absolute left-1/2 -translate-x-1/2 top-2"></div>
        <span class="text-sm font-extrabold text-slate-900">✏️ Editar Noticia</span>
        <button id="drawer-close" class="text-slate-400 hover:text-slate-700 text-2xl font-light leading-none cursor-pointer p-1">&times;</button>
      </div>

      <div class="p-5 space-y-4 flex-1">
        <input type="hidden" id="edit-id" />
        <input type="hidden" id="edit-filename" />

        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Título</label>
          <textarea id="edit-titulo" rows="2"
            class="w-full text-base font-bold text-slate-900 bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-sky-500 focus:outline-none resize-none leading-snug"></textarea>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Copete / Bajada</label>
          <textarea id="edit-copete" rows="2"
            class="w-full text-sm text-slate-700 bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-sky-500 focus:outline-none resize-none"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Categoría</label>
            <select id="edit-cat" class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-sky-500 focus:outline-none font-medium">
              <option value="Río y Clima">Río y Clima</option>
              <option value="Comunidad">Comunidad</option>
              <option value="Obras y Servicios">Obras y Servicios</option>
              <option value="Deportes">Deportes</option>
              <option value="Salud y Educación">Salud y Educación</option>
              <option value="Turismo y Cultura">Turismo y Cultura</option>
              <option value="Sociedad">Sociedad</option>
            </select>
          </div>
          <div class="flex items-end pb-0.5">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="edit-alerta" class="w-5 h-5 text-rose-600 rounded cursor-pointer" />
              <span class="text-xs font-bold text-rose-800">🚨 Alerta</span>
            </label>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">🖼️ URL de imagen</label>
          <input type="url" id="edit-imagen"
            class="w-full text-xs font-mono bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-sky-500 focus:outline-none" />
          <div class="mt-2 flex flex-wrap gap-1.5 text-[11px]">
            <button type="button" class="q-img bg-slate-100 hover:bg-slate-200 text-slate-700 px-2 py-1 rounded-lg cursor-pointer" data-img="https://www.diarioelargentino.com/galeria/fotos/2026/08/21/m_1787313394_21810.webp">🏛️ Gobierno</button>
            <button type="button" class="q-img bg-slate-100 hover:bg-slate-200 text-slate-700 px-2 py-1 rounded-lg cursor-pointer" data-img="https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=1200&q=80">🌊 Río</button>
            <button type="button" class="q-img bg-slate-100 hover:bg-slate-200 text-slate-700 px-2 py-1 rounded-lg cursor-pointer" data-img="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=1200&q=80">🏥 Hospital</button>
            <button type="button" class="q-img bg-slate-100 hover:bg-slate-200 text-slate-700 px-2 py-1 rounded-lg cursor-pointer" data-img="https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=1200&q=80">📚 Educación</button>
            <button type="button" class="q-img bg-slate-100 hover:bg-slate-200 text-slate-700 px-2 py-1 rounded-lg cursor-pointer" data-img="https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=1200&q=80">⚖️ Justicia</button>
            <button type="button" class="q-img bg-slate-100 hover:bg-slate-200 text-slate-700 px-2 py-1 rounded-lg cursor-pointer" data-img="https://images.unsplash.com/photo-1570042225831-d98fa7577f1e?auto=format&fit=crop&w=1200&q=80">🐄 Ganadería</button>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">📝 Resumen del post</label>
          <p class="text-[11px] text-slate-400 mb-2">2-3 oraciones cortas. Máximo 300 caracteres. Solo hechos verificables.</p>
          <textarea id="edit-cuerpo" rows="3" maxlength="300" placeholder="Ej: El Municipio de Villa Paranacito inauguró el acceso pavimentado al centro. La obra beneficia a más de 2.000 vecinos."
            class="w-full text-sm text-slate-800 bg-slate-50 border border-slate-300 rounded-xl px-3 py-3 focus:ring-2 focus:ring-sky-500 focus:outline-none leading-relaxed resize-none"></textarea>
          <p id="resumen-counter" class="text-[11px] text-slate-400 text-right mt-0.5">0 / 300</p>
        </div>
      </div>

      <!-- Acciones sticky abajo -->
      <div class="sticky bottom-0 bg-white border-t border-slate-100 p-4 flex gap-2 shadow-[0_-4px_20px_rgba(0,0,0,0.07)]">
        <button id="btn-delete" type="button"
          class="px-4 py-3 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-xs rounded-xl transition-colors cursor-pointer flex items-center gap-1.5">
          🗑️ Eliminar
        </button>
        <button id="btn-save" type="button"
          class="flex-1 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-sm rounded-xl transition-colors cursor-pointer flex items-center justify-center gap-2 shadow-md">
          <span id="save-icon">💾</span>
          <span id="save-label">Guardar Cambios</span>
        </button>
      </div>
    </div>
  </div>

</Layout>

<script define:vars={{ allNews, serverGeminiKey }}>
  window.__PN_DATA = allNews;
  window.__PN_GEMINI = serverGeminiKey;
</script>

<script>
  // ══════════════════════════════════════════════════════════════════
  // UTILIDADES
  // ══════════════════════════════════════════════════════════════════
  const DEFAULT_PIN = '0453';
  const API_URL = '/api/gh';

  function getPin(): string { return localStorage.getItem('pn_pin') || DEFAULT_PIN; }
  function getGeminiKey(): string { return localStorage.getItem('pn_gemini') || (window as any).__PN_GEMINI || ''; }

  function slugify(t: string): string {
    return t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9\s-]/g, '').trim().replace(/[\s-]+/g, '-').split('-').slice(0, 7).join('-');
  }

  // Llamada al endpoint server-side (el token nunca está en el browser)
  async function apiCall(action: string, payload: object): Promise<{ ok: boolean; error?: string; action?: string; path?: string }> {
    const pin = getPin();
    const res = await fetch(API_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action, pin, payload }),
    });
    return res.json();
  }

  // ══════════════════════════════════════════════════════════════════
  // CAPTURAS DE PANTALLA (fuente visual para el generador de IA)
  // ══════════════════════════════════════════════════════════════════
  type CapturaLista = { mime: string; base64: string; previewUrl: string; fileName: string };
  let capturaFiles: CapturaLista[] = [];
  const MAX_CAPTURAS = 4;

  // Redimensiona y comprime la imagen en el navegador antes de mandarla a
  // Gemini (Vision) y antes de subirla al repo, para que el JSON de la API
  // y el commit a GitHub sean livianos y rápidos.
  function compressImageFile(file: File, maxDim = 1600, quality = 0.85): Promise<CapturaLista> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onerror = () => reject(new Error('No se pudo leer el archivo.'));
      reader.onload = () => {
        const img = new Image();
        img.onerror = () => reject(new Error('No se pudo procesar la imagen.'));
        img.onload = () => {
          let { width, height } = img;
          if (width > maxDim || height > maxDim) {
            const ratio = Math.min(maxDim / width, maxDim / height);
            width = Math.round(width * ratio);
            height = Math.round(height * ratio);
          }
          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          if (!ctx) { reject(new Error('Canvas no disponible.')); return; }
          ctx.drawImage(img, 0, width, height);
          const dataUrl = canvas.toDataURL('image/jpeg', quality);
          const base64 = dataUrl.split(',')[1] || '';
          resolve({ mime: 'image/jpeg', base64, previewUrl: dataUrl, fileName: file.name });
        };
        img.src = reader.result as string;
      };
      reader.readAsDataURL(file);
    });
  }

  function renderCapturaPreview() {
    const wrap = document.getElementById('captura-preview')!;
    wrap.innerHTML = '';
    if (capturaFiles.length === 0) { wrap.classList.add('hidden'); return; }
    wrap.classList.remove('hidden');
    capturaFiles.forEach((c, i) => {
      const box = document.createElement('div');
      box.className = 'relative w-20 h-20 rounded-xl overflow-hidden border-2 ' + (i === 0 ? 'border-sky-500' : 'border-slate-200');
      box.innerHTML = `
        <img src="${c.previewUrl}" class="w-full h-full object-cover" alt="Captura ${i + 1}" />
        ${i === 0 ? '<span class="absolute bottom-0 left-0 right-0 bg-sky-600 text-white text-[9px] font-bold text-center py-0.5">PORTADA</span>' : ''}
        <button type="button" data-idx="${i}" class="btn-remove-captura absolute top-0.5 right-0.5 w-5 h-5 bg-black/70 text-white rounded-full text-xs font-bold flex items-center justify-center cursor-pointer">×</button>
      `;
      wrap.appendChild(box);
    });
    wrap.querySelectorAll('.btn-remove-captura').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = Number((btn as HTMLElement).dataset.idx);
        capturaFiles.splice(idx, 1);
        renderCapturaPreview();
      });
    });
  }

  document.getElementById('captura-input')!.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const files = Array.from(input.files || []);
    input.value = ''; // permite volver a elegir el mismo archivo si lo saca y lo repone
    const errEl = document.getElementById('create-error')!;
    errEl.classList.add('hidden');
    for (const file of files) {
      if (capturaFiles.length >= MAX_CAPTURAS) {
        errEl.textContent = `Máximo ${MAX_CAPTURAS} capturas por noticia.`;
        errEl.classList.remove('hidden');
        break;
      }
      if (!file.type.startsWith('image/')) continue;
      try {
        const captura = await compressImageFile(file);
        capturaFiles.push(captura);
      } catch (err: any) {
        errEl.textContent = err.message || 'Error al procesar la imagen.';
        errEl.classList.remove('hidden');
      }
    }
    renderCapturaPreview();
  });

  // ══════════════════════════════════════════════════════════════════
  // DETECCIÓN DE NOTICIAS REPETIDAS (misma lógica que el portal público)
  // ══════════════════════════════════════════════════════════════════
  const DUP_STOPWORDS = new Set([
    'de', 'la', 'el', 'en', 'y', 'a', 'los', 'del', 'se', 'las', 'por', 'un', 'para', 'con',
    'no', 'una', 'su', 'al', 'lo', 'como', 'mas', 'pero', 'sus', 'le', 'ya', 'o', 'fue',
    'este', 'ha', 'si', 'porque', 'esta', 'son', 'entre', 'cuando', 'muy', 'sin', 'tras',
    'sobre', 'ser', 'tiene', 'tambien', 'me', 'hasta', 'hay', 'donde', 'quien', 'desde',
    'todo', 'nos', 'durante', 'todos', 'uno', 'les', 'ni', 'contra', 'otros', 'ese', 'eso',
    'ante', 'ellos', 'esto', 'antes', 'algunos', 'que', 'noticias', 'noticia', 'diario',
    'villa', 'paranacito', 'delta', 'entrerriano', 'entre', 'rios',
  ]);

  function dupKeywords(text: string): Set<string> {
    const norm = (text || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9\s]/g, ' ');
    return new Set(norm.split(/\s+/).filter(w => w.length >= 4 && !DUP_STOPWORDS.has(w)));
  }

  function dupOverlap(a: Set<string>, b: Set<string>): number {
    if (a.size === 0 || b.size === 0) return 0;
    let matches = 0;
    for (const w of a) if (b.has(w)) matches++;
    return matches / Math.min(a.size, b.size);
  }

  function findLikelyDuplicate(titulo: string, copete: string): { item: any; pct: number } | null {
    const pool: any[] = (window as any).__PN_DATA || [];
    const kw = dupKeywords(`${titulo} ${copete}`);
    let best: { item: any; pct: number } | null = null;
    for (const item of pool) {
      const itemKw = dupKeywords(`${item.titulo || ''} ${item.copete || ''} ${item.resumen || ''}`);
      const overlap = dupOverlap(kw, itemKw);
      if (overlap >= 0.35 && (!best || overlap > best.pct)) {
        best = { item, pct: overlap };
      }
    }
    return best;
  }

  function getSemanticImage(title: string, text: string, cat: string, custom: string): string {
    if (custom?.startsWith('http')) return custom;
    const full = `${title} ${text} ${cat}`.toLowerCase();
    if (/hacienda|ganado|vaca|rodeo/.test(full)) return 'https://images.unsplash.com/photo-1570042225831-d98fa7577f1e?auto=format&fit=crop&w=1200&q=80';
    if (/policia|detencion|profuga|justicia|penal|estafa/.test(full)) return 'https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=1200&q=80';
    if (/cazador|ciervo|humedal|fauna|visor/.test(full)) return 'https://images.unsplash.com/photo-1484406566174-9da000fda645?auto=format&fit=crop&w=1200&q=80';
    if (/hospital|medic|guardia|vacuna|salud/.test(full)) return 'https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=1200&q=80';
    if (/escuela|docente|concurso|instituto|enfermeria/.test(full)) return 'https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=1200&q=80';
    if (/obra|camino|vialidad|puente/.test(full)) return 'https://images.unsplash.com/photo-1541888946425-d0fbb18086f6?auto=format&fit=crop&w=1200&q=80';
    if (/futbol|deporte|club/.test(full)) return 'https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=1200&q=80';
    if (/turismo|pesca|muelle/.test(full)) return 'https://images.unsplash.com/photo-1498654896293-37aacf113fd9?auto=format&fit=crop&w=1200&q=80';
    return 'https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=1200&q=80';
  }

  // ══════════════════════════════════════════════════════════════════
  // LOGIN (solo PIN)
  // ══════════════════════════════════════════════════════════════════
  const authScreen = document.getElementById('auth-screen')!;
  const mainPanel = document.getElementById('main-panel')!;
  const inputPin = document.getElementById('input-pin') as HTMLInputElement;
  const loginError = document.getElementById('login-error')!;

  function showPanel() {
    authScreen.classList.add('hidden');
    mainPanel.classList.remove('hidden');
    // Precargar clave Gemini
    const geminiInput = document.getElementById('gemini-key') as HTMLInputElement;
    const geminiStatus = document.getElementById('gemini-status')!;
    const saved = getGeminiKey();
    if (geminiInput) {
      if (saved) {
        geminiInput.value = saved;
        geminiStatus.textContent = 'Activa ✓';
        geminiStatus.className = 'text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full';
      }
      // Guardar en localStorage al cambiar
      geminiInput.addEventListener('change', () => {
        const v = geminiInput.value.trim();
        if (v) {
          localStorage.setItem('pn_gemini', v);
          geminiStatus.textContent = 'Activa ✓';
          geminiStatus.className = 'text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full';
        }
      });
    }
  }

  if (sessionStorage.getItem('pn_auth') === '1') showPanel();

  document.getElementById('btn-login')!.addEventListener('click', () => {
    const pin = inputPin.value.trim();
    if (pin !== getPin()) {
      loginError.classList.remove('hidden');
      inputPin.classList.add('border-rose-400', 'ring-2', 'ring-rose-200');
      return;
    }
    sessionStorage.setItem('pn_auth', '1');
    loginError.classList.add('hidden');
    inputPin.classList.remove('border-rose-400', 'ring-2', 'ring-rose-200');
    showPanel();
  });
  inputPin.addEventListener('keydown', e => { if (e.key === 'Enter') (document.getElementById('btn-login') as HTMLButtonElement).click(); });

  document.getElementById('btn-logout')!.addEventListener('click', () => {
    sessionStorage.removeItem('pn_auth');
    mainPanel.classList.add('hidden');
    authScreen.classList.remove('hidden');
    inputPin.value = '';
  });

  document.getElementById('btn-change-pin')!.addEventListener('click', () => {
    const np = prompt('Nuevo PIN (mínimo 4 caracteres):');
    if (np && np.trim().length >= 4) {
      localStorage.setItem('pn_pin', np.trim());
      alert('✅ PIN actualizado.');
    }
  });

  // ══════════════════════════════════════════════════════════════════
  // TABS
  // ══════════════════════════════════════════════════════════════════
  const viewCrear = document.getElementById('view-crear')!;
  const viewAdmin = document.getElementById('view-admin')!;

  function activateTab(tab: 'crear' | 'admin') {
    const isCrear = tab === 'crear';
    viewCrear.classList.toggle('hidden', !isCrear);
    viewAdmin.classList.toggle('hidden', isCrear);
    const activeClass = 'tab-btn px-4 py-2.5 text-xs sm:text-sm font-bold rounded-t-xl border-b-2 border-sky-600 text-sky-700 bg-sky-50 transition-all cursor-pointer';
    const idleClass = 'tab-btn px-4 py-2.5 text-xs sm:text-sm font-bold rounded-t-xl border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition-all cursor-pointer';
    document.getElementById('tab-crear')!.className = isCrear ? activeClass : idleClass;
    document.getElementById('tab-admin')!.className = !isCrear ? activeClass : idleClass;
    if (!isCrear) renderNewsList();
  }

  document.getElementById('tab-crear')!.addEventListener('click', () => activateTab('crear'));
  document.getElementById('tab-admin')!.addEventListener('click', () => activateTab('admin'));

  // ══════════════════════════════════════════════════════════════════
  // LISTA DE NOTICIAS
  // ══════════════════════════════════════════════════════════════════
  let newsList: any[] = (window as any).__PN_DATA || [];
  const newsListEl = document.getElementById('news-list')!;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const catFilter = document.getElementById('cat-filter') as HTMLSelectElement;

  function renderNewsList() {
    const q = searchInput?.value.toLowerCase().trim() || '';
    const cat = catFilter?.value || '';
    const badgeEl = document.getElementById('badge-total');
    if (badgeEl) badgeEl.textContent = String(newsList.length);

    const filtered = newsList.filter(n =>
      (!cat || n.categoria === cat) &&
      (!q || (n.titulo || '').toLowerCase().includes(q) || (n.copete || '').toLowerCase().includes(q))
    );

    if (!filtered.length) {
      newsListEl.innerHTML = `<div class="text-center py-12 text-slate-400 bg-white rounded-2xl border border-slate-200 p-8">
        <p class="font-bold text-slate-600">Sin resultados</p>
        <p class="text-xs mt-1">Probá con otro filtro.</p>
      </div>`;
      return;
    }

    newsListEl.innerHTML = filtered.map(n => {
      const img = n.imagen?.startsWith('http')
        ? n.imagen
        : 'https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=400&q=70';
      const slug = (n.slug || '').replace(/"/g, '');
      const titulo = (n.titulo || '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      const fecha = (n.fecha_publicacion || '').replace(/</g, '&lt;');
      const cat2 = (n.categoria || 'Comunidad').replace(/</g, '&lt;');
      return `<div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all overflow-hidden">
        <div class="flex">
          <div class="w-28 h-28 sm:w-32 sm:h-32 shrink-0">
            <img src="${img}" alt="" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="flex-1 p-3 flex flex-col justify-between min-w-0">
            <div>
              <div class="flex items-center gap-1.5 mb-1 flex-wrap">
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-sky-50 text-sky-700 border border-sky-200">${cat2}</span>
                ${n.es_alerta ? '<span class="text-[10px] font-black px-2 py-0.5 rounded-full bg-rose-600 text-white">🚨</span>' : ''}
              </div>
              <p class="text-sm font-bold text-slate-900 leading-snug line-clamp-2">${titulo}</p>
              <p class="text-[11px] text-slate-400 mt-0.5">${fecha}</p>
            </div>
            <div class="flex items-center gap-2 mt-2 pt-2 border-t border-slate-100">
              <button class="btn-edit flex-1 text-xs font-bold bg-sky-50 hover:bg-sky-100 text-sky-700 py-2 rounded-xl transition-colors cursor-pointer" data-slug="${slug}">
                ✏️ Editar post
              </button>
              ${n.url_original ? `<a href="${n.url_original}" target="_blank" title="Abrir fuente original" class="text-xs font-bold px-3 py-2 bg-slate-50 hover:bg-slate-100 text-slate-500 rounded-xl transition-colors">🔗 Fuente</a>` : ''}
            </div>

          </div>
        </div>
      </div>`;
    }).join('');
  }

  // Delegación de eventos — un solo listener para todos los botones Editar
  newsListEl.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('.btn-edit') as HTMLElement | null;
    if (!btn) return;
    const slug = btn.dataset.slug;
    const item = newsList.find(n => n.slug === slug);
    if (item) openDrawer(item);
  });

  searchInput?.addEventListener('input', renderNewsList);
  catFilter?.addEventListener('change', renderNewsList);


  // ══════════════════════════════════════════════════════════════════
  // DRAWER DE EDICIÓN
  // ══════════════════════════════════════════════════════════════════
  const drawer = document.getElementById('edit-drawer')!;
  const drawerOverlay = document.getElementById('drawer-overlay')!;
  let editingItem: any = null;

  const eId = document.getElementById('edit-id') as HTMLInputElement;
  const eFilename = document.getElementById('edit-filename') as HTMLInputElement;
  const eTitulo = document.getElementById('edit-titulo') as HTMLTextAreaElement;
  const eCopete = document.getElementById('edit-copete') as HTMLTextAreaElement;
  const eCat = document.getElementById('edit-cat') as HTMLSelectElement;
  const eAlerta = document.getElementById('edit-alerta') as HTMLInputElement;
  const eImagen = document.getElementById('edit-imagen') as HTMLInputElement;
  const eCuerpo = document.getElementById('edit-cuerpo') as HTMLTextAreaElement;

  // Contador de caracteres del resumen
  const resumenCounter = document.getElementById('resumen-counter');
  eCuerpo?.addEventListener('input', () => {
    if (resumenCounter) resumenCounter.textContent = `${eCuerpo.value.length} / 300`;
  });

  function openDrawer(item: any) {
    editingItem = item;
    eId.value = item.slug || item.id;
    eFilename.value = item.archivo || `${item.slug}.json`;
    eTitulo.value = item.titulo || '';
    eCopete.value = item.copete || item.resumen || '';
    eCat.value = item.categoria || 'Comunidad';
    eAlerta.checked = !!item.es_alerta;
    eImagen.value = item.imagen?.startsWith('http') ? item.imagen : '';
    // Cargar resumen (campo nuevo). Si no existe, usar copete o primer párrafo del cuerpo
    eCuerpo.value = item.resumen || item.copete || (Array.isArray(item.cuerpo) ? item.cuerpo[0] : item.cuerpo) || '';
    if (eCuerpo.value.length > 300) eCuerpo.value = eCuerpo.value.slice(0, 300);
    if (resumenCounter) resumenCounter.textContent = `${eCuerpo.value.length} / 300`;
    drawer.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer.classList.add('hidden');
    document.body.style.overflow = '';
    editingItem = null;
  }

  document.getElementById('drawer-close')!.addEventListener('click', closeDrawer);
  drawerOverlay.addEventListener('click', closeDrawer);

  drawer.querySelectorAll('.q-img').forEach(btn => {
    btn.addEventListener('click', () => {
      const url = (btn as HTMLElement).dataset.img;
      if (url) eImagen.value = url;
    });
  });

  // ── GUARDAR ──────────────────────────────────────────────────────
  document.getElementById('btn-save')!.addEventListener('click', async () => {
    if (!editingItem) return;
    const saveIcon = document.getElementById('save-icon')!;
    const saveLabel = document.getElementById('save-label')!;
    const btn = document.getElementById('btn-save') as HTMLButtonElement;

    const title = eTitulo.value.trim();
    const resumen = eCuerpo.value.trim();
    if (!title || !resumen) { alert('El título y el resumen son obligatorios.'); return; }
    if (resumen.length > 300) { alert('El resumen no puede superar los 300 caracteres.'); return; }

    const imagen = eImagen.value.trim() || getSemanticImage(title, resumen, eCat.value, '');

    const updated = {
      ...editingItem,
      titulo: title,
      resumen,
      copete: resumen,              // Mantener compatibilidad
      categoria: eCat.value,
      es_alerta: eAlerta.checked, imagen,
      fecha_ultima_actualizacion: new Date().toLocaleDateString('es-AR'),
      fecha_ultima_actualizacion_iso: new Date().toISOString(),
    };

    btn.disabled = true;
    saveIcon.textContent = '⏳';
    saveLabel.textContent = 'Guardando...';

    try {
      const result = await apiCall('save', { filename: eFilename.value, content: updated });
      if (!result.ok) throw new Error(result.error || 'Error del servidor');
      const idx = newsList.findIndex(n => n.slug === updated.slug);
      if (idx !== -1) newsList[idx] = { ...newsList[idx], ...updated };
      renderNewsList();
      closeDrawer();
      alert('✅ Guardado. El sitio se actualiza en ~30 segundos.');
    } catch (err: any) {
      alert(`Error al guardar: ${err.message}`);
    } finally {
      btn.disabled = false;
      saveIcon.textContent = '💾';
      saveLabel.textContent = 'Guardar Cambios';
    }
  });


  // ── ELIMINAR ─────────────────────────────────────────────────────
  document.getElementById('btn-delete')!.addEventListener('click', async () => {
    if (!editingItem) return;
    if (!confirm(`¿Eliminar la nota:\n"${editingItem.titulo}"?`)) return;

    const btn = document.getElementById('btn-delete') as HTMLButtonElement;
    btn.textContent = '⏳';
    btn.disabled = true;

    try {
      const result = await apiCall('delete', { filename: eFilename.value });
      if (!result.ok) throw new Error(result.error || 'Error del servidor');
      newsList = newsList.filter(n => n.slug !== editingItem.slug);
      document.getElementById('badge-total')!.textContent = String(newsList.length);
      renderNewsList();
      closeDrawer();
      alert('✅ Nota eliminada. El sitio se actualiza en ~30 segundos.');
    } catch (err: any) {
      alert(`Error al eliminar: ${err.message}`);
    } finally {
      btn.innerHTML = '🗑️ Eliminar';
      btn.disabled = false;
    }
  });

  // ══════════════════════════════════════════════════════════════════
  // CREADOR CON GEMINI
  // ══════════════════════════════════════════════════════════════════
  const geminiInput = document.getElementById('gemini-key') as HTMLInputElement;
  const geminiStatus = document.getElementById('gemini-status')!;

  geminiInput?.addEventListener('input', () => {
    const v = geminiInput.value.trim();
    if (v) {
      localStorage.setItem('pn_gemini', v);
      geminiStatus.textContent = 'Activa ✓';
      geminiStatus.className = 'text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full';
    } else {
      geminiStatus.textContent = 'Sin configurar';
      geminiStatus.className = 'text-[10px] font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full';
    }
  });

  let generatedData: any = null;

  let pendingCoverCaptura: CapturaLista | null = null;

  document.getElementById('btn-generar')!.addEventListener('click', async () => {
    const key = geminiInput.value.trim() || getGeminiKey();
    const raw = (document.getElementById('raw-text') as HTMLTextAreaElement).value.trim();
    const cat = (document.getElementById('categoria-select') as HTMLSelectElement).value;
    const fuente = (document.getElementById('fuente-nombre') as HTMLInputElement).value.trim();
    const conf = (document.getElementById('confiabilidad-select') as HTMLSelectElement).value;
    const alerta = (document.getElementById('es-alerta') as HTMLInputElement).checked;
    const customImg = (document.getElementById('imagen-url') as HTMLInputElement).value.trim();
    const errEl = document.getElementById('create-error')!;
    errEl.classList.add('hidden');
    document.getElementById('dup-warning')!.classList.add('hidden');
    document.getElementById('relevance-warning')!.classList.add('hidden');
    (document.getElementById('dup-override') as HTMLInputElement).checked = false;

    const tieneCapturas = capturaFiles.length > 0;
    if (!raw && !tieneCapturas) { errEl.textContent = 'Ingresá el texto a redactar o subí al menos una captura.'; errEl.classList.remove('hidden'); return; }
    if (!key) { errEl.textContent = 'Ingresá tu clave de Gemini API.'; errEl.classList.remove('hidden'); return; }

    localStorage.setItem('pn_gemini', key);

    const btn = document.getElementById('btn-generar') as HTMLButtonElement;
    const icon = document.getElementById('btn-icon')!;
    const lbl = document.getElementById('btn-text')!;
    btn.disabled = true;
    icon.textContent = '⏳';
    lbl.textContent = tieneCapturas ? 'Leyendo capturas...' : 'Redactando...';

    const instruccionFuente = tieneCapturas
      ? `Se adjuntan ${capturaFiles.length} captura(s) de pantalla de posteo(s) en redes sociales (Facebook/Instagram/WhatsApp). Leé TODO el texto visible en cada imagen (autor, cuerpo del posteo, comentarios relevantes, fecha si aparece) y usalo como la información bruta principal.${raw ? ' Sumale también este contexto adicional aportado por el editor:\n' + raw : ''}`
      : `INFORMACIÓN BRUTA:\n${raw}`;

    const prompt = `Sos el Jefe de Redacción de "Paranacito Noticias", un portal hiperlocal de Villa Paranacito, Delta de Entre Ríos, Argentina.

${instruccionFuente}

FUENTE DECLARADA: ${fuente} | CATEGORÍA SUGERIDA: ${cat}

REGLA CRÍTICA DE RELEVANCIA: Esta nota SOLO es válida si el hecho ocurrió en Villa Paranacito (o Islas del Ibicuy / Delta de Villa Paranacito) o tiene a Villa Paranacito y sus vecinos como protagonistas directos. Si el contenido es sobre otro lugar, es genérico, es propaganda/publicidad sin valor noticioso, o no podés confirmar el ancla local, marcá "relevante_villa_paranacito": false y explicá por qué en "motivo_relevancia" — igual completá el resto de los campos con tu mejor esfuerzo.

Si es relevante, transformá la información en una nota periodística neutral y completa (4-6 párrafos ricos, sin opiniones propias, atribuyendo lo que sea una opinión de terceros). Devolvé SOLO un JSON válido, sin markdown, con este formato exacto:
{"relevante_villa_paranacito":true,"motivo_relevancia":"string breve","titulo":"string","copete":"string","cuerpo":["p1","p2","p3","p4"],"categoria":"${cat}","tags":["villa paranacito","delta","entre rios"],"slug":"slug-amigable","tiempo_lectura":"3 min","resumen_whatsapp":"📰 *Título*\\n\\nResumen.\\n\\n🔗 paranacito-noticias.vercel.app"}`;

    const parts: any[] = [];
    capturaFiles.forEach(c => parts.push({ inline_data: { mime_type: c.mime, data: c.base64 } }));
    parts.push({ text: prompt });

    const endpoints = [
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${key}`,
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent?key=${key}`,
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${key}`,
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${key}`,
    ];

    try {
      let data: any = null;
      for (const url of endpoints) {
        try {
          const r = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{ parts }],
              generationConfig: { temperature: 0.25, responseMimeType: 'application/json' },
            }),
          });
          if (r.ok) { data = await r.json(); break; }
        } catch {}
      }
      if (!data) throw new Error('No se pudo conectar con Gemini. Verificá tu clave.');

      const txt = data.candidates[0].content.parts[0].text;
      const parsed = JSON.parse(txt.replace(/^```json\s*/, '').replace(/\s*```$/, '').trim());

      if (parsed.relevante_villa_paranacito === false) {
        document.getElementById('relevance-motivo')!.textContent = parsed.motivo_relevancia || 'La IA no encontró un ancla clara con Villa Paranacito.';
        document.getElementById('relevance-warning')!.classList.remove('hidden');
        document.getElementById('preview-container')!.classList.add('hidden');
        generatedData = null;
        pendingCoverCaptura = null;
        return;
      }

      const now = new Date();
      const slug = slugify(parsed.slug || parsed.titulo);

      // Foto de portada: 1) URL manual > 2) primera captura subida > 3) foto temática automática.
      pendingCoverCaptura = (!customImg && tieneCapturas) ? capturaFiles[0] : null;
      const imgPreview = customImg || (tieneCapturas ? capturaFiles[0].previewUrl : getSemanticImage(parsed.titulo, raw, cat, customImg));
      const imgFinal = customImg || (tieneCapturas ? '' : getSemanticImage(parsed.titulo, raw, cat, customImg)); // se completa en Publicar si viene de una captura

      generatedData = {
        acontecimiento_id: `${now.toISOString().split('T')[0]}-${slug}`,
        id: `${now.toISOString().split('T')[0]}-${slug}`,
        titulo: parsed.titulo, copete: parsed.copete, cuerpo: parsed.cuerpo,
        categoria: parsed.categoria || cat, tags: parsed.tags || ['villa paranacito', 'delta'],
        slug, tiempo_lectura: parsed.tiempo_lectura || '3 min',
        resumen_whatsapp: parsed.resumen_whatsapp,
        imagen: imgFinal, estado: alerta ? 'En desarrollo' : 'Publicado',
        nivel_confiabilidad: conf, es_alerta: alerta,
        publicado: true, requiere_revision: false,
        fuentes_consultadas: [{ nombre: tieneCapturas ? `${fuente} (captura de pantalla)` : fuente, fecha_consulta: now.toISOString() }],
        fecha_iso: now.toISOString(), fecha_inicio_iso: now.toISOString(),
        fecha_publicacion: `${now.getDate()} de ${['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'][now.getMonth()]} de ${now.getFullYear()}, ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')} hs`,
        fecha_ultima_actualizacion_iso: now.toISOString(),
        archivo: `${now.toISOString().split('T')[0]}-${slug}.json`,
      };

      // Chequeo de posible duplicado contra lo ya publicado en el portal
      const dup = findLikelyDuplicate(generatedData.titulo, generatedData.copete);
      if (dup) {
        document.getElementById('dup-title')!.textContent = dup.item.titulo || '';
        document.getElementById('dup-pct')!.textContent = String(Math.round(dup.pct * 100));
        document.getElementById('dup-warning')!.classList.remove('hidden');
      }

      // Mostrar preview
      document.getElementById('prev-cat')!.textContent = generatedData.categoria;
      alerta
        ? document.getElementById('prev-alert-badge')!.classList.remove('hidden')
        : document.getElementById('prev-alert-badge')!.classList.add('hidden');
      document.getElementById('prev-titulo')!.textContent = generatedData.titulo;
      document.getElementById('prev-copete')!.textContent = generatedData.copete;
      const imgEl = document.getElementById('prev-imagen') as HTMLImageElement;
      imgEl.src = imgPreview; imgEl.alt = generatedData.titulo;
      const cuerpoEl = document.getElementById('prev-cuerpo')!;
      cuerpoEl.innerHTML = '';
      generatedData.cuerpo.forEach((p: string) => {
        const pe = document.createElement('p'); pe.textContent = p; cuerpoEl.appendChild(pe);
      });
      document.getElementById('prev-wa')!.textContent = generatedData.resumen_whatsapp;
      document.getElementById('preview-container')!.classList.remove('hidden');
      document.getElementById('preview-container')!.scrollIntoView({ behavior: 'smooth', block: 'start' });

    } catch (err: any) {
      errEl.textContent = err.message || 'Error al generar.';
      errEl.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      icon.textContent = '✨';
      lbl.textContent = 'Redactar con Gemini 2.5';
    }
  });

  document.getElementById('btn-copy-wa')!.addEventListener('click', () => {
    if (!generatedData?.resumen_whatsapp) return;
    navigator.clipboard.writeText(generatedData.resumen_whatsapp);
    const b = document.getElementById('btn-copy-wa')!;
    const orig = b.textContent;
    b.textContent = '✅ Copiado';
    setTimeout(() => b.textContent = orig, 2000);
  });

  document.getElementById('btn-publish')!.addEventListener('click', async () => {
    if (!generatedData) return;

    const dupWarningVisible = !document.getElementById('dup-warning')!.classList.contains('hidden');
    const dupOverride = (document.getElementById('dup-override') as HTMLInputElement).checked;
    if (dupWarningVisible && !dupOverride) {
      alert('Esta nota parece repetir algo ya publicado. Tildá "Publicar de todas formas" si estás seguro/a, o revisá la nota existente en la pestaña 📰 Notas.');
      return;
    }

    const btn = document.getElementById('btn-publish') as HTMLButtonElement;
    const icon = document.getElementById('pub-icon')!;
    const lbl = document.getElementById('pub-label')!;
    btn.disabled = true;
    icon.textContent = '⏳';
    lbl.textContent = 'Publicando...';

    try {
      // Si la foto de portada viene de una captura subida, la commiteamos
      // al repo recién ahora (así no quedan imágenes huérfanas de previews descartados).
      if (pendingCoverCaptura && !generatedData.imagen) {
        icon.textContent = '📸';
        lbl.textContent = 'Subiendo captura...';
        const imgFilename = `${generatedData.slug}-${Date.now()}.jpg`;
        const imgResult = await apiCall('save_image', { filename: imgFilename, base64Data: pendingCoverCaptura.base64 });
        if (!imgResult.ok || !imgResult.path) throw new Error(imgResult.error || 'No se pudo subir la captura como foto de portada.');
        generatedData.imagen = imgResult.path;
        icon.textContent = '⏳';
        lbl.textContent = 'Publicando...';
      }
      if (!generatedData.imagen) {
        generatedData.imagen = getSemanticImage(generatedData.titulo, generatedData.copete, generatedData.categoria, '');
      }

      const result = await apiCall('save', { filename: generatedData.archivo, content: generatedData });
      if (!result.ok) throw new Error(result.error || 'Error del servidor');
      newsList.unshift(generatedData);
      (window as any).__PN_DATA = [generatedData, ...((window as any).__PN_DATA || [])];
      document.getElementById('badge-total')!.textContent = String(newsList.length);
      alert('🚀 ¡Nota publicada! Vercel actualiza el sitio en ~30 segundos.');
      document.getElementById('preview-container')!.classList.add('hidden');
      (document.getElementById('raw-text') as HTMLTextAreaElement).value = '';
      (document.getElementById('imagen-url') as HTMLInputElement).value = '';
      capturaFiles = [];
      pendingCoverCaptura = null;
      renderCapturaPreview();
      generatedData = null;
      activateTab('admin');
    } catch (err: any) {
      alert(`Error: ${err.message}`);
    } finally {
      btn.disabled = false;
      icon.textContent = '🚀';
      lbl.textContent = 'Publicar Noticia';
    }
  });
</script>
