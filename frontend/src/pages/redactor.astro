</Layout>

<!-- Inyección de Datos Estáticos para el Gestor -->
<script define:vars={{ allNews, serverGeminiKey }}>
  window.INITIAL_NEWS_DATA = allNews;
  window.DEFAULT_GEMINI_KEY = serverGeminiKey;
</script>

<script>
  // ─── 1. CONTROL DE ACCESO PRIVADO POR PIN ─────────────────────────
  const DEFAULT_PIN = "1907";
  const lockScreen = document.getElementById('auth-lock-screen');
  const adminPanel = document.getElementById('admin-panel');
  const inputPin = document.getElementById('admin-pin') as HTMLInputElement;
  const btnUnlock = document.getElementById('btn-unlock');
  const pinError = document.getElementById('pin-error');
  const btnLogout = document.getElementById('btn-logout');
  const btnChangePin = document.getElementById('btn-change-pin');
  const btnConfigGithub = document.getElementById('btn-config-github');
  const lblGithubStatus = document.getElementById('lbl-github-status');

  function getStoredPin(): string {
    return localStorage.getItem('pn_admin_pin') || DEFAULT_PIN;
  }

  function updateGithubStatusLabel() {
    const token = localStorage.getItem('pn_gh_token');
    if (lblGithubStatus) {
      if (token) {
        lblGithubStatus.textContent = 'GitHub Conectado ✅';
        btnConfigGithub?.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-200');
      } else {
        lblGithubStatus.textContent = 'Conectar GitHub (1-Clic)';
        btnConfigGithub?.classList.remove('bg-emerald-50', 'text-emerald-700', 'border-emerald-200');
      }
    }
  }

  btnConfigGithub?.addEventListener('click', () => {
    const current = localStorage.getItem('pn_gh_token') || '';
    const nuevo = prompt(
      "🔑 Conexión Directa con GitHub (1-Clic):\n\n" +
      "Ingresá tu Personal Access Token de GitHub con permiso 'repo'.\n" +
      "Esto te permitirá publicar, editar y eliminar noticias en 1 clic directamente desde esta pantalla sin abrir GitHub.\n\n" +
      "(Podés crear uno en: https://github.com/settings/tokens/new?scopes=repo&description=ParanacitoAdmin)",
      current
    );
    if (nuevo !== null) {
      if (nuevo.trim()) {
        localStorage.setItem('pn_gh_token', nuevo.trim());
        alert("✅ GitHub conectado exitosamente. Ya podés borrar, editar y publicar notas en 1 clic.");
      } else {
        localStorage.removeItem('pn_gh_token');
        alert("Conexión de GitHub removida.");
      }
      updateGithubStatusLabel();
    }
  });

  function checkAuth() {
    const isAuth = sessionStorage.getItem('pn_admin_auth') === 'true';
    if (isAuth) {
      lockScreen?.classList.add('hidden');
      adminPanel?.classList.remove('hidden');
      updateGithubStatusLabel();
    } else {
      lockScreen?.classList.remove('hidden');
      adminPanel?.classList.add('hidden');
    }
  }

  btnUnlock?.addEventListener('click', () => {
    const entered = inputPin?.value.trim();
    if (entered === getStoredPin()) {
      sessionStorage.setItem('pn_admin_auth', 'true');
      if (pinError) pinError.classList.add('hidden');
      checkAuth();
    } else {
      if (pinError) pinError.classList.remove('hidden');
    }
  });

  inputPin?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') btnUnlock?.click();
  });

  btnLogout?.addEventListener('click', () => {
    sessionStorage.removeItem('pn_admin_auth');
    if (inputPin) inputPin.value = '';
    checkAuth();
  });

  btnChangePin?.addEventListener('click', () => {
    const nuevo = prompt("Ingresá tu nuevo PIN de administrador (mínimo 4 caracteres):");
    if (nuevo && nuevo.trim().length >= 4) {
      localStorage.setItem('pn_admin_pin', nuevo.trim());
      alert("✅ PIN actualizado exitosamente.");
    }
  });

  checkAuth();

  // ─── 2. MANEJO DE PESTAÑAS ───────────────────────────────────────
  const tabBtnCreate = document.getElementById('tab-btn-create');
  const tabBtnManage = document.getElementById('tab-btn-manage');
  const viewCreate = document.getElementById('view-create');
  const viewManage = document.getElementById('view-manage');

  tabBtnCreate?.addEventListener('click', () => {
    tabBtnCreate.className = 'tab-button active px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all bg-river-600 text-white shadow-sm cursor-pointer';
    tabBtnManage?.classList.remove('bg-river-600', 'text-white', 'shadow-sm');
    tabBtnManage?.classList.add('bg-slate-100', 'text-slate-700');
    viewCreate?.classList.remove('hidden');
    viewManage?.classList.add('hidden');
  });

  tabBtnManage?.addEventListener('click', () => {
    tabBtnManage.className = 'tab-button active px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all bg-river-600 text-white shadow-sm cursor-pointer';
    tabBtnCreate?.classList.remove('bg-river-600', 'text-white', 'shadow-sm');
    tabBtnCreate?.classList.add('bg-slate-100', 'text-slate-700');
    viewManage?.classList.remove('hidden');
    viewCreate?.classList.add('hidden');
    renderNewsGrid();
  });

  // ─── 3. GESTIÓN Y EDICIÓN DE NOTICIAS ────────────────────────────
  let newsList: any[] = (window as any).INITIAL_NEWS_DATA || [];
  const newsGrid = document.getElementById('news-grid');
  const searchInput = document.getElementById('manage-search') as HTMLInputElement;
  const catFilter = document.getElementById('manage-cat-filter') as HTMLSelectElement;

  const editModal = document.getElementById('edit-modal');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const btnCancelEdit = document.getElementById('btn-cancel-edit');
  const btnSaveEdit = document.getElementById('btn-save-edit');
  const btnDeleteArticle = document.getElementById('btn-delete-article');

  const editArticleId = document.getElementById('edit-article-id') as HTMLInputElement;
  const editArticleFilename = document.getElementById('edit-article-filename') as HTMLInputElement;
  const editTitle = document.getElementById('edit-title') as HTMLInputElement;
  const editCopete = document.getElementById('edit-copete') as HTMLTextAreaElement;
  const editCategoria = document.getElementById('edit-categoria') as HTMLSelectElement;
  const editEsAlerta = document.getElementById('edit-es-alerta') as HTMLInputElement;
  const editImagen = document.getElementById('edit-imagen') as HTMLInputElement;
  const editCuerpo = document.getElementById('edit-cuerpo') as HTMLTextAreaElement;

  let currentEditingItem: any = null;

  function renderNewsGrid() {
    if (!newsGrid) return;
    const search = searchInput?.value.toLowerCase().trim() || '';
    const cat = catFilter?.value || 'todas';

    const filtered = newsList.filter(n => {
      const matchSearch = (n.titulo || '').toLowerCase().includes(search) || (n.copete || '').toLowerCase().includes(search);
      const matchCat = cat === 'todas' || n.categoria === cat;
      return matchSearch && matchCat;
    });

    const badgeCount = document.getElementById('count-news-badge');
    if (badgeCount) badgeCount.textContent = String(newsList.length);

    if (filtered.length === 0) {
      newsGrid.innerHTML = `
        <div class="col-span-full py-12 text-center text-slate-400 bg-white rounded-2xl border border-slate-200 p-8">
          <p class="text-base font-bold text-slate-600">No se encontraron noticias</p>
          <p class="text-xs text-slate-400 mt-1">Probá con otro término de búsqueda o categoría.</p>
        </div>
      `;
      return;
    }

    newsGrid.innerHTML = filtered.map((n) => {
      const isAlerta = n.es_alerta === true;
      const imgUrl = n.imagen && n.imagen.startsWith('http') ? n.imagen : 'https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=600&q=80';
      return `
        <div class="bg-white rounded-2xl border border-slate-200/90 p-4 shadow-sm hover:shadow-md transition-all flex gap-4 items-start">
          <div class="w-24 h-24 rounded-xl overflow-hidden bg-slate-100 shrink-0 aspect-square">
            <img src="${imgUrl}" alt="${n.titulo}" class="w-full h-full object-cover" />
          </div>

          <div class="flex-1 min-w-0 flex flex-col justify-between h-full">
            <div>
              <div class="flex items-center gap-1.5 mb-1.5 flex-wrap">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-river-50 text-river-700 border border-river-200">
                  ${n.categoria}
                </span>
                ${isAlerta ? '<span class="px-1.5 py-0.5 rounded-full text-[10px] font-black bg-rose-600 text-white animate-pulse">🚨 ALERTA</span>' : ''}
                <span class="text-[10px] text-slate-400 ml-auto">${n.fecha_publicacion || ''}</span>
              </div>

              <h4 class="text-sm font-bold text-slate-900 leading-snug line-clamp-2 mb-1">
                ${n.titulo}
              </h4>
            </div>

            <div class="flex items-center gap-2 pt-2 border-t border-slate-100 mt-2">
              <button
                class="btn-edit-item text-xs font-bold bg-river-50 hover:bg-river-100 text-river-700 px-3 py-1 rounded-lg transition-colors cursor-pointer"
                data-slug="${n.slug}"
              >
                ✏️ Editar
              </button>
              <a
                href="/noticias/${n.slug}"
                target="_blank"
                class="text-xs text-slate-500 hover:text-slate-800 px-2 py-1 rounded-lg transition-colors"
              >
                🔗 Ver en web
              </a>
            </div>
          </div>
        </div>
      `;
    }).join('');

    // Asignar listeners a botones de editar
    document.querySelectorAll('.btn-edit-item').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const slug = (e.currentTarget as HTMLElement).getAttribute('data-slug');
        const item = newsList.find(n => n.slug === slug);
        if (item) openEditModal(item);
      });
    });
  }

  searchInput?.addEventListener('input', renderNewsGrid);
  catFilter?.addEventListener('change', renderNewsGrid);

  function openEditModal(item: any) {
    currentEditingItem = item;
    if (editArticleId) editArticleId.value = item.acontecimiento_id || item.id || item.slug;
    if (editArticleFilename) editArticleFilename.value = item.archivo || `${item.slug}.json`;
    if (editTitle) editTitle.value = item.titulo || '';
    if (editCopete) editCopete.value = item.copete || '';
    if (editCategoria) editCategoria.value = item.categoria || 'Comunidad';
    if (editEsAlerta) editEsAlerta.checked = item.es_alerta === true;
    if (editImagen) editImagen.value = item.imagen && item.imagen.startsWith('http') ? item.imagen : '';

    const bodyText = Array.isArray(item.cuerpo) ? item.cuerpo.join('\n\n') : (item.cuerpo || '');
    if (editCuerpo) editCuerpo.value = bodyText;

    editModal?.classList.remove('hidden');
  }

  function closeModal() {
    editModal?.classList.add('hidden');
    currentEditingItem = null;
  }

  btnCloseModal?.addEventListener('click', closeModal);
  btnCancelEdit?.addEventListener('click', closeModal);

  // Galería rápida en modal
  document.querySelectorAll('.btn-quick-img').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const url = (e.currentTarget as HTMLElement).getAttribute('data-img');
      if (editImagen && url) editImagen.value = url;
    });
  });

  // Guardar cambios (con soporte GitHub API 1-clic)
  btnSaveEdit?.addEventListener('click', async () => {
    if (!currentEditingItem) return;

    const title = editTitle?.value.trim();
    const copete = editCopete?.value.trim();
    const categoria = editCategoria?.value;
    const esAlerta = editEsAlerta?.checked;
    const imagen = editImagen?.value.trim() || 'https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=1200&q=80';
    const cuerpoArr = editCuerpo?.value.split('\n\n').map(p => p.trim()).filter(p => p.length > 0);

    if (!title || !copete) {
      alert("Por favor completá el título y el copete.");
      return;
    }

    const updated = {
      ...currentEditingItem,
      titulo: title,
      copete: copete,
      categoria: categoria,
      es_alerta: esAlerta,
      imagen: imagen,
      cuerpo: cuerpoArr,
      fecha_ultima_actualizacion: `Hoy, ${new Date().toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' })} hs`,
      fecha_ultima_actualizacion_iso: new Date().toISOString()
    };

    const filename = updated.archivo || `${updated.slug}.json`;
    const token = localStorage.getItem('pn_gh_token');

    if (token) {
      try {
        const getUrl = `https://api.github.com/repos/andresehansen/Paranacito-noticias/contents/data/noticias/${filename}`;
        const getResp = await fetch(getUrl, {
          headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github.v3+json' }
        });
        const getJson = getResp.ok ? await getResp.json() : null;
        const sha = getJson ? getJson.sha : undefined;

        const contentBase64 = btoa(unescape(encodeURIComponent(JSON.stringify(updated, null, 2))));
        const putResp = await fetch(getUrl, {
          method: 'PUT',
          headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github.v3+json', 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: `Actualizar noticia: ${updated.slug}`,
            content: contentBase64,
            sha: sha,
            branch: 'main'
          })
        });

        if (!putResp.ok) throw new Error("Error al guardar en GitHub.");

        // Actualizar en memoria
        const idx = newsList.findIndex(n => n.slug === updated.slug);
        if (idx !== -1) newsList[idx] = updated;
        renderNewsGrid();
        closeModal();
        alert("✅ ¡Noticia actualizada directamente en GitHub! Vercel desplegará los cambios en 30 segundos.");
        return;
      } catch (err: any) {
        console.error(err);
      }
    }

    // Fallback descarga JSON
    const jsonStr = JSON.stringify(updated, null, 2);
    const blob = new Blob([jsonStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);

    alert(`✅ Archivo "${filename}" descargado.\n\nSubilo a "data/noticias/" en GitHub o conectá tu Token en el botón superior para guardar en 1 clic.`);
    closeModal();
  });

  // Eliminar nota (con soporte GitHub API 1-clic)
  btnDeleteArticle?.addEventListener('click', async () => {
    if (!currentEditingItem) return;
    const filename = currentEditingItem.archivo || `${currentEditingItem.slug}.json`;
    const token = localStorage.getItem('pn_gh_token');

    const confirmDelete = confirm(`¿Estás seguro de que querés eliminar la nota:\n"${currentEditingItem.titulo}"?`);
    if (!confirmDelete) return;

    if (token) {
      try {
        const getUrl = `https://api.github.com/repos/andresehansen/Paranacito-noticias/contents/data/noticias/${filename}`;
        const getResp = await fetch(getUrl, {
          headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github.v3+json' }
        });

        if (getResp.ok) {
          const getJson = await getResp.json();
          const sha = getJson.sha;

          const delResp = await fetch(getUrl, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github.v3+json', 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: `Eliminar noticia: ${currentEditingItem.slug}`,
              sha: sha,
              branch: 'main'
            })
          });

          if (!delResp.ok) throw new Error("Error en la llamada DELETE de GitHub.");
        }

        // Remover de la lista visual
        newsList = newsList.filter(n => n.slug !== currentEditingItem.slug);
        renderNewsGrid();
        closeModal();
        alert("✅ ¡Noticia eliminada directamente del repositorio con éxito! Vercel actualizará la página en 30 segundos.");
        return;
      } catch (err: any) {
        alert(`Error al eliminar en GitHub: ${err.message}`);
      }
    }

    // Si no hay token configurado, remover localmente
    newsList = newsList.filter(n => n.slug !== currentEditingItem.slug);
    renderNewsGrid();
    closeModal();
    alert(`Nota removida de la vista actual.\n\nPara borrarla permanentemente sin token, eliminá "${filename}" en GitHub.`);
  });

  // ─── 4. CREADOR DE NOTICIAS CON GEMINI ───────────────────────────
  const inputKey = document.getElementById('gemini-key') as HTMLInputElement;
  const savedKey = localStorage.getItem('gemini_api_key') || '';
  const defaultKey = (window as any).DEFAULT_GEMINI_KEY || '';

  if (inputKey) {
    if (savedKey) {
      inputKey.value = savedKey;
    } else if (defaultKey) {
      inputKey.value = defaultKey;
    }
  }

  const btnGenerar = document.getElementById('btn-generar');
  const btnIcon = document.getElementById('btn-icon');
  const btnText = document.getElementById('btn-text');
  const errorMsg = document.getElementById('error-msg');

  const previewPlaceholder = document.getElementById('preview-placeholder');
  const previewContainer = document.getElementById('preview-container');
  const prevTitulo = document.getElementById('prev-titulo');
  const prevCopete = document.getElementById('prev-copete');
  const prevCuerpo = document.getElementById('prev-cuerpo');
  const prevCategoria = document.getElementById('prev-categoria');
  const prevAlerta = document.getElementById('prev-alerta');
  const prevImagen = document.getElementById('prev-imagen') as HTMLImageElement;
  const prevImagenContainer = document.getElementById('prev-imagen-container');
  const prevTags = document.getElementById('prev-tags');
  const prevWhatsapp = document.getElementById('prev-whatsapp');
  const btnCopyWa = document.getElementById('btn-copy-wa');
  const btnDownloadJson = document.getElementById('btn-download-json');
  const btnPublishDirect = document.getElementById('btn-publish-direct');

  let generatedArticleData: any = null;

  const THEMATIC_CATALOG: Record<string, string[]> = {
    ganaderia_campo: [
      'https://images.unsplash.com/photo-1570042225831-d98fa7577f1e?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1546445317-29f4545e9d53?auto=format&fit=crop&w=1200&q=80'
    ],
    policia_justicia: [
      'https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1589578527966-fdac0f44566c?auto=format&fit=crop&w=1200&q=80'
    ],
    fauna_humedales: [
      'https://images.unsplash.com/photo-1484406566174-9da000fda645?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=1200&q=80'
    ],
    rio_crecida: [
      'https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1473448912268-2022ce9509d8?auto=format&fit=crop&w=1200&q=80'
    ],
    salud_hospital: [
      'https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1586773860418-d37222d8fce3?auto=format&fit=crop&w=1200&q=80'
    ],
    educacion_docentes: [
      'https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=1200&q=80',
      'https://images.unsplash.com/photo-1524178232363-1fb2b075b655?auto=format&fit=crop&w=1200&q=80'
    ],
    obras_vialidad: [
      'https://images.unsplash.com/photo-1541888946425-d0fbb18086f6?auto=format&fit=crop&w=1200&q=80'
    ],
    deportes: [
      'https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=1200&q=80'
    ],
    turismo_pesca: [
      'https://images.unsplash.com/photo-1498654896293-37aacf113fd9?auto=format&fit=crop&w=1200&q=80'
    ],
    comunidad_sociedad: [
      'https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=1200&q=80'
    ]
  };

  function getSemanticImage(title: string, text: string, category: string, customUrl: string): string {
    if (customUrl && customUrl.startsWith('http') && !customUrl.includes('photo-1511632765486-a01980e01a18')) {
      return customUrl;
    }
    const full = `${title} ${text} ${category}`.toLowerCase();
    if (full.includes('hacienda') || full.includes('ganado') || full.includes('vaca') || full.includes('rodeo') || full.includes('rural')) {
      return THEMATIC_CATALOG.ganaderia_campo[0];
    }
    if (full.includes('policia') || full.includes('deten') || full.includes('profug') || full.includes('justicia') || full.includes('penal') || full.includes('estafa')) {
      return THEMATIC_CATALOG.policia_justicia[0];
    }
    if (full.includes('cazador') || full.includes('fauna') || full.includes('ciervo') || full.includes('humedal') || full.includes('visor')) {
      return THEMATIC_CATALOG.fauna_humedales[0];
    }
    if (full.includes('hospital') || full.includes('salud') || full.includes('medic') || full.includes('guardia') || full.includes('vacuna')) {
      return THEMATIC_CATALOG.salud_hospital[0];
    }
    if (full.includes('escuela') || full.includes('docente') || full.includes('concurso') || full.includes('instituto') || full.includes('enfermeria')) {
      return THEMATIC_CATALOG.educacion_docentes[0];
    }
    if (full.includes('obra') || full.includes('camino') || full.includes('vialidad') || full.includes('puente')) {
      return THEMATIC_CATALOG.obras_vialidad[0];
    }
    if (full.includes('futbol') || full.includes('deporte') || full.includes('club')) {
      return THEMATIC_CATALOG.deportes[0];
    }
    if (full.includes('turismo') || full.includes('pesca') || full.includes('cabana') || full.includes('rio')) {
      return THEMATIC_CATALOG.turismo_pesca[0];
    }
    return THEMATIC_CATALOG.rio_crecida[0];
  }


  function slugify(text: string): string {
    return text
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9\s-]/g, '')
      .trim()
      .replace(/[\s-]+/g, '-')
      .split('-')
      .slice(0, 7)
      .join('-');
  }

  btnGenerar?.addEventListener('click', async () => {
    if (errorMsg) errorMsg.classList.add('hidden');

    const apiKey = inputKey?.value.trim() || (window as any).DEFAULT_GEMINI_KEY || '';
    const rawText = (document.getElementById('raw-text') as HTMLTextAreaElement)?.value.trim();
    const fuente = (document.getElementById('fuente-nombre') as HTMLInputElement)?.value.trim() || 'Reporte Comunitario';
    const categoria = (document.getElementById('categoria-select') as HTMLSelectElement)?.value || 'Comunidad';
    const confiabilidad = (document.getElementById('confiabilidad-select') as HTMLSelectElement)?.value || 'Media';
    const esAlerta = (document.getElementById('es-alerta') as HTMLInputElement)?.checked || false;
    let customImg = (document.getElementById('imagen-url') as HTMLInputElement)?.value.trim();

    if (!rawText) {
      if (errorMsg) {
        errorMsg.textContent = 'Por favor ingresá los datos o el texto a redactar.';
        errorMsg.classList.remove('hidden');
      }
      return;
    }

    if (!apiKey) {
      if (errorMsg) {
        errorMsg.textContent = 'Por favor ingresá tu clave de Gemini API para redactar.';
        errorMsg.classList.remove('hidden');
      }
      return;
    }

    localStorage.setItem('gemini_api_key', apiKey);

    if (btnGenerar && btnIcon && btnText) {
      btnGenerar.setAttribute('disabled', 'true');
      btnIcon.textContent = '⏳';
      btnText.textContent = 'Redactando con Gemini 2.5...';
    }

    const prompt = `Sos el Jefe de Redacción Senior de "Paranacito Noticias", el portal digital de referencia de Villa Paranacito y el Delta de Entre Ríos.
Tu misión es transformar el siguiente reporte o información cruda en una NOTA PERIODÍSTICA COMPLETA, RICA EN CONTENIDO, PROFUNDA Y DE ALTO VALOR INFORMATIVO para la comunidad isleña.

DATOS BRUTOS PROVISTOS:
${rawText}

FUENTE / ORIGEN: ${fuente}
CATEGORÍA: ${categoria}

PAUTAS EDITORIALES OBLIGATORIAS:
1. Titular atractivo, claro y periodístico.
2. Copete o bajada de 1 a 2 oraciones que sintetice el hecho central.
3. Cuerpo extenso y rico en contenido (4 a 6 párrafos sustanciosos):
   - Párrafo 1: El hecho principal con precisión territorial (Villa Paranacito, Río Paranacito, arroyos, instituciones).
   - Párrafo 2: Detalles específicos, declaraciones o antecedentes.
   - Párrafo 3: Impacto directo en los vecinos, familias isleñas o actividades locales (navegación, caminos, servicios).
   - Párrafo 4: Recomendaciones, medidas técnicas o información de servicio y contacto.
4. Resumen ágil para WhatsApp con emojis informativos.

Generá tu respuesta EXCLUSIVAMENTE como un objeto JSON válido (sin bloques de código adicionales), con este formato exacto:
{
  "titulo": "string",
  "copete": "string",
  "cuerpo": [
    "Párrafo 1...",
    "Párrafo 2...",
    "Párrafo 3...",
    "Párrafo 4..."
  ],
  "categoria": "${categoria}",
  "tags": ["villa paranacito", "delta", "entre rios", "${categoria.toLowerCase()}"],
  "slug": "slug-amigable-con-guiones",
  "tiempo_lectura": "3 min",
  "resumen_whatsapp": "📰 *Título*\\n\\nResumen periodístico para WhatsApp.\\n\\n🔗 Leé más en paranacito-noticias.vercel.app"
}`;

    try {
      const endpoints = [
        `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`,
        `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent?key=${apiKey}`,
        `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${apiKey}`,
        `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`
      ];

      let resData = null;
      for (const url of endpoints) {
        try {
          const resp = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{ parts: [{ text: prompt }] }],
              generationConfig: { temperature: 0.25, responseMimeType: 'application/json' }
            })
          });
          if (resp.ok) {
            resData = await resp.json();
            break;
          }
        } catch (e) {}
      }

      if (!resData) {
        throw new Error("No se pudo conectar con Gemini API. Verificá tu clave.");
      }

      const textContent = resData.candidates[0].content.parts[0].text;
      const cleanJson = textContent.replace(/^```json\s*/, '').replace(/\s*```$/, '').trim();
      const parsed = JSON.parse(cleanJson);

      const now = new Date();
      const nowIso = now.toISOString();
      const finalSlug = slugify(parsed.slug || parsed.titulo);
      const finalImg = getSemanticImage(parsed.titulo, rawText, categoria, customImg);

      generatedArticleData = {

        acontecimiento_id: `${nowIso.split('T')[0]}-${finalSlug}`,
        id: `${nowIso.split('T')[0]}-${finalSlug}`,
        titulo: parsed.titulo,
        copete: parsed.copete,
        cuerpo: parsed.cuerpo,
        categoria: parsed.categoria || categoria,
        tags: parsed.tags || ['villa paranacito', 'delta'],
        slug: finalSlug,
        tiempo_lectura: parsed.tiempo_lectura || '3 min',
        resumen_whatsapp: parsed.resumen_whatsapp,
        imagen: finalImg,
        estado: esAlerta ? 'En desarrollo' : 'Publicado',
        nivel_confiabilidad: confiabilidad,
        es_alerta: esAlerta,
        requiere_revision: false,
        publicado: true,
        fuentes_consultadas: [{ nombre: fuente, fecha_consulta: nowIso }],
        cronologia_actualizaciones: [
          {
            hora: `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`,
            fecha: nowIso.split('T')[0],
            fuente: fuente,
            dato: parsed.copete,
            es_dato_nuevo: true
          }
        ],
        fecha_inicio_iso: nowIso,
        fecha_iso: nowIso,
        fecha_publicacion: `Hoy, ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')} hs`,
        fecha_ultima_actualizacion: `Hoy, ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')} hs`,
        archivo: `${nowIso.split('T')[0]}-${finalSlug}.json`
      };

      if (prevTitulo) prevTitulo.textContent = generatedArticleData.titulo;
      if (prevCopete) prevCopete.textContent = generatedArticleData.copete;
      if (prevCategoria) prevCategoria.textContent = generatedArticleData.categoria;
      
      if (prevAlerta) {
        if (esAlerta) prevAlerta.classList.remove('hidden');
        else prevAlerta.classList.add('hidden');
      }

      if (prevImagen && prevImagenContainer) {
        prevImagen.src = finalImg;
        prevImagenContainer.classList.remove('hidden');
      }

      if (prevCuerpo) {
        prevCuerpo.innerHTML = '';
        generatedArticleData.cuerpo.forEach((p: string) => {
          const pEl = document.createElement('p');
          pEl.textContent = p;
          prevCuerpo.appendChild(pEl);
        });
      }

      if (prevTags) {
        prevTags.innerHTML = '';
        generatedArticleData.tags.forEach((tag: string) => {
          const tEl = document.createElement('span');
          tEl.className = 'bg-slate-100 text-slate-700 px-2.5 py-0.5 rounded-lg border border-slate-200';
          tEl.textContent = `#${tag}`;
          prevTags.appendChild(tEl);
        });
      }

      if (prevWhatsapp) prevWhatsapp.textContent = generatedArticleData.resumen_whatsapp;
      if (previewPlaceholder) previewPlaceholder.classList.add('hidden');
      if (previewContainer) previewContainer.classList.remove('hidden');

    } catch (err: any) {
      if (errorMsg) {
        errorMsg.textContent = `Error: ${err.message || 'No se pudo generar la noticia.'}`;
        errorMsg.classList.remove('hidden');
      }
    } finally {
      if (btnGenerar && btnIcon && btnText) {
        btnGenerar.removeAttribute('disabled');
        btnIcon.textContent = '✨';
        btnText.textContent = 'Redactar Noticia con Gemini 2.5';
      }
    }
  });

  btnCopyWa?.addEventListener('click', () => {
    if (!generatedArticleData) return;
    navigator.clipboard.writeText(generatedArticleData.resumen_whatsapp);
    if (btnCopyWa) {
      const orig = btnCopyWa.textContent;
      btnCopyWa.textContent = '✅ Copiado!';
      setTimeout(() => { btnCopyWa.textContent = orig; }, 2000);
    }
  });

  btnPublishDirect?.addEventListener('click', async () => {
    if (!generatedArticleData) return;
    const token = localStorage.getItem('pn_gh_token');
    const filename = generatedArticleData.archivo;

    if (!token) {
      btnConfigGithub?.click();
      return;
    }

    try {
      btnPublishDirect.setAttribute('disabled', 'true');
      btnPublishDirect.textContent = '⏳ Publicando...';

      const getUrl = `https://api.github.com/repos/andresehansen/Paranacito-noticias/contents/data/noticias/${filename}`;
      const contentBase64 = btoa(unescape(encodeURIComponent(JSON.stringify(generatedArticleData, null, 2))));
      
      const putResp = await fetch(getUrl, {
        method: 'PUT',
        headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github.v3+json', 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message: `Publicar noticia: ${generatedArticleData.slug}`,
          content: contentBase64,
          branch: 'main'
        })
      });

      if (!putResp.ok) throw new Error("Error al publicar en GitHub.");

      newsList.unshift(generatedArticleData);
      renderNewsGrid();
      alert("🚀 ¡Noticia publicada exitosamente en Paranacito Noticias! Vercel actualizará la portada en 30 segundos.");
      tabBtnManage?.click();

    } catch (err: any) {
      alert(`Error al publicar: ${err.message}`);
    } finally {
      btnPublishDirect.removeAttribute('disabled');
      btnPublishDirect.innerHTML = '<span>🚀</span><span>Publicar Directo (1-Clic)</span>';
    }
  });

  btnDownloadJson?.addEventListener('click', () => {
    if (!generatedArticleData) return;
    const jsonStr = JSON.stringify(generatedArticleData, null, 2);
    const blob = new Blob([jsonStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = generatedArticleData.archivo;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });
</script>
