---
import Layout from '../layouts/Layout.astro';
import noticiasIndex from '../../../data/noticias_index.json';

// Cargar todas las noticias completas disponibles
const fullNewsFiles = import.meta.glob('../../../data/noticias/*.json', { eager: true });
const allNews = Object.values(fullNewsFiles).map((file: any) => file.default || file);
allNews.sort((a: any, b: any) => String(b.fecha_iso || b.fecha_inicio_iso || '').localeCompare(String(a.fecha_iso || a.fecha_inicio_iso || '')));

const serverGeminiKey = import.meta.env.PUBLIC_GEMINI_API_KEY || import.meta.env.GEMINI_API_KEY || process.env.GEMINI_API_KEY || '';
---

<Layout
  title="Mesa de Redacción y Gestión Editorial | Paranacito Noticias"
  description="Panel privado de administración y redacción."
>
  <head slot="head">
    <meta name="robots" content="noindex, nofollow, noarchive" />
  </head>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 1. PANTALLA DE BLOQUEO POR PIN PRIVADO                       -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <div id="auth-lock-screen" class="max-w-md mx-auto my-16 p-8 bg-white rounded-3xl border border-slate-200 shadow-xl text-center">
    <div class="w-16 h-16 bg-slate-900 text-white rounded-2xl flex items-center justify-center text-2xl mx-auto mb-4 shadow-md">
      🔒
    </div>
    <h2 class="text-xl font-extrabold text-slate-900 mb-1">Mesa de Redacción Privada</h2>
    <p class="text-xs text-slate-500 mb-6">
      Área exclusiva para crear, editar y gestionar noticias de Paranacito Noticias.
    </p>

    <div class="space-y-4">
      <div>
        <label for="admin-pin" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 text-left">
          Ingresá tu PIN de Administrador
        </label>
        <input
          type="password"
          id="admin-pin"
          placeholder="••••"
          maxlength="20"
          class="w-full text-center text-lg font-mono tracking-widest bg-slate-50 border border-slate-300 rounded-xl py-3 px-4 focus:ring-2 focus:ring-river-500 focus:outline-none"
        />
      </div>

      <button
        type="button"
        id="btn-unlock"
        class="w-full py-3 bg-river-600 hover:bg-river-700 text-white font-bold text-sm rounded-xl shadow transition-colors cursor-pointer"
      >
        Ingresar al Panel
      </button>

      <div id="pin-error" class="hidden text-xs text-rose-600 font-semibold pt-1">
        PIN incorrecto. Intentá nuevamente.
      </div>

      <p class="text-[11px] text-slate-400 pt-3 border-t border-slate-100">
        PIN por defecto inicial: <code class="bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded font-mono font-bold">1907</code> (podés cambiarlo dentro del panel).
      </p>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- 2. PANEL DE ADMINISTRACIÓN (AUTENTICADO)                     -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <div id="admin-panel" class="hidden max-w-6xl mx-auto py-6 px-4 sm:px-6">
    
    <!-- Encabezado del Panel -->
    <header class="mb-6 pb-5 border-b border-slate-200 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="p-2.5 bg-river-100 text-river-700 rounded-xl text-xl">✍️</span>
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Mesa de Redacción y Gestión Editorial
          </h1>
          <p class="text-xs text-slate-500">
            Paranacito Noticias — Villa Paranacito y Delta de Entre Ríos.
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2 flex-wrap">
        <button
          id="btn-config-github"
          class="text-xs text-slate-700 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-lg transition-colors cursor-pointer flex items-center gap-1.5 font-medium border border-slate-300"
          title="Permite borrar, editar y publicar notas directamente en GitHub sin descargar archivos"
        >
          <span>🐙</span>
          <span id="lbl-github-status">Conectar GitHub (1-Clic)</span>
        </button>

        <button
          id="btn-change-pin"
          class="text-xs text-slate-600 hover:text-slate-900 bg-slate-100 px-3 py-1.5 rounded-lg transition-colors cursor-pointer"
        >
          ⚙️ Cambiar PIN
        </button>
        <button
          id="btn-logout"
          class="text-xs text-rose-600 hover:text-rose-700 bg-rose-50 px-3 py-1.5 rounded-lg font-semibold transition-colors cursor-pointer"
        >
          Cerrar Sesión
        </button>
      </div>
    </header>

    <!-- Barra de Pestañas Principales -->
    <nav class="flex items-center gap-3 mb-8 border-b border-slate-200 pb-3">
      <button
        id="tab-btn-create"
        class="tab-button active px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all bg-river-600 text-white shadow-sm cursor-pointer"
      >
        ✨ Crear Noticia con IA
      </button>
      <button
        id="tab-btn-manage"
        class="tab-button px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all bg-slate-100 hover:bg-slate-200 text-slate-700 cursor-pointer"
      >
        📰 Administrar y Editar Notas (<span id="count-news-badge">{allNews.length}</span>)
      </button>
    </nav>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- PESTAÑA 1: CREADOR DE NOTICIAS CON IA                        -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div id="view-create" class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Formulario de Entrada (Columna Izquierda) -->
      <section class="lg:col-span-5 space-y-5 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm h-fit">
        
        <!-- API Key Gemini -->
        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="gemini-key" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
              🔑 Clave Gemini API
            </label>
            <span id="badge-key-status" class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md">
              Activa
            </span>
          </div>
          <input
            type="password"
            id="gemini-key"
            placeholder="Pegá tu clave de Google AI Studio"
            class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-river-500 focus:outline-none font-mono"
          />
        </div>

        <!-- Fuente / Origen del Reporte -->
        <div>
          <label for="fuente-nombre" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
            📰 Origen de la información
          </label>
          <input
            type="text"
            id="fuente-nombre"
            placeholder="Ej: Reporte de vecinos / SMN / Bomberos / Municipalidad"
            value="Reporte Comunitario"
            class="w-full text-sm bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-river-500 focus:outline-none"
          />
        </div>

        <!-- Categoría y Confiabilidad -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="categoria-select" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
              🏷️ Categoría
            </label>
            <select
              id="categoria-select"
              class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-river-500 focus:outline-none font-medium"
            >
              <option value="Río y Clima">Río y Clima</option>
              <option value="Comunidad" selected>Comunidad</option>
              <option value="Obras y Servicios">Obras y Servicios</option>
              <option value="Deportes">Deportes</option>
              <option value="Salud y Educación">Salud y Educación</option>
              <option value="Turismo y Cultura">Turismo y Cultura</option>
              <option value="Sociedad">Sociedad</option>
            </select>
          </div>

          <div>
            <label for="confiabilidad-select" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
              🛡️ Confiabilidad
            </label>
            <select
              id="confiabilidad-select"
              class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-river-500 focus:outline-none font-medium"
            >
              <option value="Alta">🟢 Alta (Oficial)</option>
              <option value="Media" selected>🟡 Media (Vecinos/Medio)</option>
              <option value="Baja">🔴 Baja (En verificación)</option>
            </select>
          </div>
        </div>

        <!-- Switch de Alerta Urgente -->
        <div class="flex items-center justify-between p-3.5 bg-rose-50 border border-rose-200 rounded-xl">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">🚨</span>
            <div>
              <div class="text-xs font-bold text-rose-900">¿Es una Alerta Urgente?</div>
              <div class="text-[11px] text-rose-700">Aparecerá en el banner rojo pulsante de la portada.</div>
            </div>
          </div>
          <input
            type="checkbox"
            id="es-alerta"
            class="w-5 h-5 text-rose-600 rounded focus:ring-rose-500 border-rose-300 cursor-pointer"
          />
        </div>

        <!-- Selector de Imagen -->
        <div>
          <label for="imagen-url" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
            🖼️ Foto de Portada (URL)
          </label>
          <input
            type="text"
            id="imagen-url"
            placeholder="Pegá la URL de una foto o dejalo vacío para asignación automática del Delta"
            class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-river-500 focus:outline-none font-mono"
          />
        </div>

        <!-- Datos Crudos a Redactar -->
        <div>
          <label for="raw-text" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
            📝 Datos brutos, audio transcripto o mensaje del vecino
          </label>
          <textarea
            id="raw-text"
            rows="6"
            placeholder="Ejemplo: Hay alerta por repunte del río para esta noche por vientos del sudeste. Se esperan 2.10 metros para la madrugada según Prefectura. Se recomienda amarrar bien las embarcaciones y levantar elementos en muelles bajos."
            class="w-full text-xs text-slate-800 bg-slate-50 border border-slate-300 rounded-xl p-3.5 focus:ring-2 focus:ring-river-500 focus:outline-none leading-relaxed"
          ></textarea>
        </div>

        <!-- Botón de Generación -->
        <button
          type="button"
          id="btn-generar"
          class="w-full py-3.5 bg-gradient-to-r from-river-600 to-teal-600 hover:from-river-700 hover:to-teal-700 text-white font-bold text-sm rounded-xl shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <span id="btn-icon">✨</span>
          <span id="btn-text">Redactar Noticia con Gemini 2.5</span>
        </button>

        <div id="error-msg" class="hidden text-xs text-rose-600 font-semibold p-3 bg-rose-50 rounded-xl border border-rose-200"></div>

      </section>

      <!-- Columna Derecha: Vista Previa y Publicación -->
      <section class="lg:col-span-7 space-y-6">
        
        <div id="preview-placeholder" class="h-full min-h-[400px] border-2 border-dashed border-slate-300 rounded-2xl flex flex-col items-center justify-center p-8 text-center bg-slate-50 text-slate-400">
          <span class="text-4xl mb-3">📰</span>
          <h3 class="text-sm font-bold text-slate-600">Vista Previa de la Noticia</h3>
          <p class="text-xs max-w-sm mt-1">
            Completá los datos a la izquierda y hacé clic en "Redactar Noticia" para generar el artículo completo y publicarlo en 1 clic.
          </p>
        </div>

        <!-- Vista Previa Generada -->
        <div id="preview-container" class="hidden space-y-6">
          <article class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
            
            <div class="flex flex-wrap items-center gap-2 mb-4">
              <span id="prev-categoria" class="px-3 py-0.5 rounded-full text-xs font-semibold bg-river-100 text-river-800 border border-river-200">
                Comunidad
              </span>
              <span id="prev-alerta" class="hidden px-3 py-0.5 rounded-full text-xs font-black bg-rose-600 text-white animate-pulse">
                🚨 ALERTA
              </span>
            </div>

            <h2 id="prev-titulo" class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight mb-4"></h2>
            <p id="prev-copete" class="text-base text-slate-700 font-medium leading-relaxed bg-slate-100/90 p-4 rounded-xl border-l-4 border-river-600 mb-6"></p>

            <div id="prev-imagen-container" class="mb-6 rounded-xl overflow-hidden aspect-[16/9] bg-slate-200">
              <img id="prev-imagen" src="" alt="" class="w-full h-full object-cover" />
            </div>

            <div id="prev-cuerpo" class="prose prose-slate max-w-none text-slate-800 text-base leading-relaxed space-y-4 mb-6"></div>
            <div id="prev-tags" class="flex flex-wrap gap-1.5 pt-4 border-t border-slate-200 text-xs"></div>
          </article>

          <!-- WhatsApp -->
          <div class="bg-gradient-to-r from-emerald-600 to-green-700 text-white rounded-2xl p-5 shadow-md">
            <div class="flex items-center justify-between gap-2 mb-2">
              <div class="flex items-center gap-2">
                <span class="text-lg">💬</span>
                <span class="text-xs font-black uppercase tracking-wider">Texto para Grupos de WhatsApp</span>
              </div>
              <button
                id="btn-copy-wa"
                class="text-xs bg-white text-emerald-800 font-bold px-3 py-1 rounded-lg hover:bg-emerald-50 transition-colors shadow-sm cursor-pointer"
              >
                Copiar
              </button>
            </div>
            <pre id="prev-whatsapp" class="text-xs bg-black/20 p-3 rounded-xl whitespace-pre-wrap font-sans leading-relaxed"></pre>
          </div>

          <!-- Publicar Directo / Descargar -->
          <div class="bg-slate-900 text-white rounded-2xl p-6 shadow-md space-y-4">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
              <div>
                <h3 class="text-sm font-bold">Publicar en Paranacito Noticias</h3>
                <p class="text-xs text-slate-400">Publicá directo en el repositorio o descargá el archivo JSON.</p>
              </div>
              <div class="flex items-center gap-2 w-full sm:w-auto">
                <button
                  id="btn-publish-direct"
                  class="flex-1 sm:flex-none px-4 py-2.5 bg-river-600 hover:bg-river-500 font-bold text-xs rounded-xl transition-colors flex items-center justify-center gap-2 shadow cursor-pointer"
                >
                  <span>🚀</span>
                  <span>Publicar Directo (1-Clic)</span>
                </button>
                <button
                  id="btn-download-json"
                  class="px-3 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs rounded-xl transition-colors flex items-center justify-center gap-1.5 border border-slate-700 cursor-pointer"
                  title="Descargar archivo JSON"
                >
                  <span>📥</span>
                </button>
              </div>
            </div>
          </div>

        </div>

      </section>

    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- PESTAÑA 2: GESTOR DE NOTICIAS PUBLICADAS                     -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div id="view-manage" class="hidden space-y-6">
      
      <!-- Barra de Filtros y Búsqueda -->
      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="relative w-full sm:w-80">
          <input
            type="text"
            id="manage-search"
            placeholder="🔍 Buscar por título o tema..."
            class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl pl-3 pr-8 py-2.5 focus:ring-2 focus:ring-river-500 focus:outline-none"
          />
        </div>

        <div class="flex items-center gap-2 w-full sm:w-auto overflow-x-auto pb-1 sm:pb-0">
          <select
            id="manage-cat-filter"
            class="text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 focus:ring-2 focus:ring-river-500 focus:outline-none font-medium"
          >
            <option value="todas">Todas las categorías</option>
            <option value="Río y Clima">Río y Clima</option>
            <option value="Comunidad">Comunidad</option>
            <option value="Obras y Servicios">Obras y Servicios</option>
            <option value="Deportes">Deportes</option>
            <option value="Salud y Educación">Salud y Educación</option>
            <option value="Turismo y Cultura">Turismo y Cultura</option>
            <option value="Sociedad">Sociedad</option>
          </select>
        </div>
      </div>

      <!-- Lista de Noticias en Grid -->
      <div id="news-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Renderizado dinámico vía JavaScript -->
      </div>

    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- MODAL DE EDICIÓN DE NOTICIA                                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div id="edit-modal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 overflow-y-auto">
      <div class="bg-white rounded-3xl border border-slate-200 shadow-2xl max-w-3xl w-full p-6 sm:p-8 space-y-5 my-8 max-h-[90vh] overflow-y-auto">
        
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <div class="flex items-center gap-2">
            <span class="text-xl">✏️</span>
            <h3 class="text-lg font-bold text-slate-900">Editar Noticia Publicada</h3>
          </div>
          <button id="btn-close-modal" class="text-slate-400 hover:text-slate-700 text-xl font-bold p-1 cursor-pointer">&times;</button>
        </div>

        <input type="hidden" id="edit-article-id" />
        <input type="hidden" id="edit-article-filename" />

        <!-- Título -->
        <div>
          <label for="edit-title" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
            Título de la Noticia
          </label>
          <input
            type="text"
            id="edit-title"
            class="w-full text-sm font-bold text-slate-900 bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2.5 focus:ring-2 focus:ring-river-500 focus:outline-none"
          />
        </div>

        <!-- Copete -->
        <div>
          <label for="edit-copete" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
            Copete / Bajada
          </label>
          <textarea
            id="edit-copete"
            rows="2"
            class="w-full text-xs font-medium text-slate-700 bg-slate-50 border border-slate-300 rounded-xl p-3 focus:ring-2 focus:ring-river-500 focus:outline-none"
          ></textarea>
        </div>

        <!-- Categoría y Alerta -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="edit-categoria" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
              🏷️ Categoría
            </label>
            <select
              id="edit-categoria"
              class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-river-500 focus:outline-none font-medium"
            >
              <option value="Río y Clima">Río y Clima</option>
              <option value="Comunidad">Comunidad</option>
              <option value="Obras y Servicios">Obras y Servicios</option>
              <option value="Deportes">Deportes</option>
              <option value="Salud y Educación">Salud y Educación</option>
              <option value="Turismo y Cultura">Turismo y Cultura</option>
              <option value="Sociedad">Sociedad</option>
            </select>
          </div>

          <div class="flex items-center gap-2 p-2 bg-rose-50 border border-rose-200 rounded-xl self-end">
            <input type="checkbox" id="edit-es-alerta" class="w-4 h-4 text-rose-600 rounded cursor-pointer" />
            <label for="edit-es-alerta" class="text-xs font-bold text-rose-900 cursor-pointer">
              🚨 ¿Alerta Urgente?
            </label>
          </div>
        </div>

        <!-- URL de Imagen -->
        <div>
          <label for="edit-imagen" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
            🖼️ URL de Imagen de Portada
          </label>
          <input
            type="text"
            id="edit-imagen"
            class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 focus:ring-2 focus:ring-river-500 focus:outline-none font-mono"
          />

          <!-- Selector de Galería Rápida del Delta -->
          <div class="mt-2 flex flex-wrap items-center gap-2 text-[11px] text-slate-500">
            <span>Galería rápida:</span>
            <button type="button" class="btn-quick-img bg-slate-100 hover:bg-slate-200 px-2 py-0.5 rounded-lg text-slate-700 cursor-pointer" data-img="https://www.diarioelargentino.com/galeria/fotos/2026/08/21/m_1787313394_21810.webp">🏛️ Frigerio / Gobierno</button>
            <button type="button" class="btn-quick-img bg-slate-100 hover:bg-slate-200 px-2 py-0.5 rounded-lg text-slate-700 cursor-pointer" data-img="https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=1200&q=80">🌊 Río y Delta</button>
            <button type="button" class="btn-quick-img bg-slate-100 hover:bg-slate-200 px-2 py-0.5 rounded-lg text-slate-700 cursor-pointer" data-img="https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=1200&q=80">🏥 Salud y Escuela</button>
            <button type="button" class="btn-quick-img bg-slate-100 hover:bg-slate-200 px-2 py-0.5 rounded-lg text-slate-700 cursor-pointer" data-img="https://images.unsplash.com/photo-1583863788434-e58a36330cf0?auto=format&fit=crop&w=1200&q=80">⚖️ Seguridad y Justicia</button>
          </div>
        </div>

        <!-- Cuerpo de la Noticia -->
        <div>
          <label for="edit-cuerpo" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
            Cuerpo de la Noticia (Párrafos separados por doble Enter)
          </label>
          <textarea
            id="edit-cuerpo"
            rows="7"
            class="w-full text-xs text-slate-800 bg-slate-50 border border-slate-300 rounded-xl p-3 focus:ring-2 focus:ring-river-500 focus:outline-none leading-relaxed"
          ></textarea>
        </div>

        <!-- Botones de Acción del Modal -->
        <div class="flex flex-col sm:flex-row items-center justify-between pt-4 border-t border-slate-100 gap-3">
          <button
            type="button"
            id="btn-delete-article"
            class="w-full sm:w-auto px-4 py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-xs rounded-xl transition-colors cursor-pointer flex items-center justify-center gap-1.5"
          >
            <span>🗑️</span>
            <span>Eliminar Nota</span>
          </button>

          <div class="flex items-center gap-2 w-full sm:w-auto">
            <button
              type="button"
              id="btn-cancel-edit"
              class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition-colors cursor-pointer"
            >
              Cancelar
            </button>
            <button
              type="button"
              id="btn-save-edit"
              class="flex-1 sm:flex-none px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-md transition-colors flex items-center justify-center gap-2 cursor-pointer"
            >
