---
/**
 * SourcesPanel.astro — Panel de Fuentes Consultadas
 * Muestra los medios u organismos públicos que originaron la información.
 */

interface Source {
  nombre: string;
  url?: string;
  fecha_consulta?: string;
}

interface Props {
  fuentes: Source[];
  nivel_confiabilidad?: 'Alta' | 'Media' | 'Baja';
  num_actualizaciones?: number;
}

const { fuentes = [] } = Astro.props;
---

{fuentes.length > 0 && (
  <div class="my-6 bg-slate-50 border border-slate-200/90 rounded-2xl p-4 sm:p-5">
    <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-600 mb-3">
      <span>📰</span>
      <span>Fuentes consultadas para esta cobertura</span>
    </div>
    <div class="flex flex-wrap gap-2">
      {fuentes.map((fuente) => (
        <div>
          {fuente.url ? (
            <a
              href={fuente.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-river-700 bg-white border border-slate-200 px-3 py-1.5 rounded-xl hover:border-river-400 hover:bg-river-50 transition-all shadow-sm"
            >
              <span>{fuente.nombre}</span>
              <span class="text-[10px] text-slate-400 font-bold">↗</span>
            </a>
          ) : (
            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-700 bg-white border border-slate-200 px-3 py-1.5 rounded-xl shadow-sm">
              <span>{fuente.nombre}</span>
            </span>
          )}
        </div>
      ))}
    </div>
    <p class="text-[11px] text-slate-400 mt-3 leading-relaxed">
      Información periodística adaptada para la comunidad isleña de Villa Paranacito con atribución a sus fuentes originales.
    </p>
  </div>
)}
