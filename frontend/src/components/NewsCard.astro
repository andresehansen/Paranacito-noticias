---
import ShareWhatsApp from './ShareWhatsApp.astro';

interface Props {
  noticia: {
    slug: string;
    titulo: string;
    copete: string;
    categoria: string;
    fecha_publicacion: string;
    imagen?: string;
    tiempo_lectura?: string;
    resumen_whatsapp?: string;
    fuente_nombre?: string;
  };
  featured?: boolean;
}

const { noticia, featured = false } = Astro.props;

const categoryColors: Record<string, string> = {
  'Río y Clima': 'bg-sky-100 text-sky-800 border-sky-200',
  'Comunidad': 'bg-emerald-100 text-emerald-800 border-emerald-200',
  'Deportes': 'bg-amber-100 text-amber-800 border-amber-200',
  'Obras y Servicios': 'bg-purple-100 text-purple-800 border-purple-200',
  'Salud y Educación': 'bg-rose-100 text-rose-800 border-rose-200',
  'Turismo y Cultura': 'bg-teal-100 text-teal-800 border-teal-200',
  'Sociedad': 'bg-indigo-100 text-indigo-800 border-indigo-200'
};

const badgeClass = categoryColors[noticia.categoria] || 'bg-slate-100 text-slate-800 border-slate-200';
const articleUrl = `/noticias/${noticia.slug}`;
---

<article class={`group bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col ${featured ? 'md:grid md:grid-cols-12 gap-6' : ''}`}>
  
  <!-- Imagen con fallback seguro -->
  <div class={`overflow-hidden relative bg-slate-200 flex items-center justify-center ${featured ? 'md:col-span-7 aspect-[16/9] md:aspect-auto' : 'aspect-[16/9]'}`}>
    <a href={articleUrl} class="block w-full h-full">
      <img
        src={noticia.imagen || 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1000&q=80'}
        alt={noticia.titulo}
        loading="lazy"
        onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1000&q=80';"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </a>
    <span class={`absolute top-3 left-3 px-2.5 py-0.5 rounded-full text-xs font-semibold border shadow-sm ${badgeClass}`}>
      {noticia.categoria}
    </span>
  </div>

  <!-- Contenido -->
  <div class={`p-5 flex flex-col justify-between flex-1 ${featured ? 'md:col-span-5 md:p-6' : ''}`}>
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-500 mb-2">
        <span>{noticia.fecha_publicacion}</span>
        <span>•</span>
        <span>{noticia.tiempo_lectura || '2 min'}</span>
      </div>

      <h2 class={`font-bold text-slate-900 group-hover:text-river-600 transition-colors leading-snug mb-2.5 ${featured ? 'text-2xl md:text-3xl' : 'text-lg line-clamp-2'}`}>
        <a href={articleUrl}>
          {noticia.titulo}
        </a>
      </h2>

      <p class={`text-slate-600 text-sm leading-relaxed mb-4 ${featured ? 'line-clamp-3 md:line-clamp-4' : 'line-clamp-2'}`}>
        {noticia.copete}
      </p>
    </div>

    <!-- Pie de Tarjeta con WhatsApp y Leer Más -->
    <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
      <a
        href={articleUrl}
        class="text-xs font-semibold text-river-600 hover:text-river-800 inline-flex items-center gap-1"
      >
        Leer nota completa &rarr;
      </a>

      <ShareWhatsApp 
        title={noticia.titulo} 
        url={articleUrl} 
        summary={noticia.resumen_whatsapp || noticia.copete} 
        size="sm" 
      />
    </div>

  </div>

</article>
