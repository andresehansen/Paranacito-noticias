---
import climaData from '../../../data/clima_actual.json';
import AlertBanner from './AlertBanner.astro';

const { rio } = climaData;
---

<AlertBanner />

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200">
  
  <!-- Barra Superior: Localidad y Estado del Río -->
  <div class="bg-slate-900 text-slate-300 text-xs py-1.5 px-4">
    <div class="max-w-2xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="flex items-center gap-1 font-semibold text-white">📍 Villa Paranacito</span>
        <span class="text-slate-500">•</span>
        <span class="text-slate-400 text-[11px]">Delta Entrerriano</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 bg-sky-950 text-sky-300 px-2 py-0.5 rounded border border-sky-800 text-[11px]">
          <span>🌊 Río: <strong>{rio.altura_metros}m</strong></span>
          <span class="text-[10px] text-sky-400">({rio.tendencia})</span>
        </span>
      </div>
    </div>
  </div>

  <!-- Cabecera Principal Twitter-style -->
  <div class="max-w-2xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
    
    <!-- Logotipo y Nombre -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-9 h-9 rounded-xl bg-sky-500 flex items-center justify-center text-white shadow-sm font-bold text-lg group-hover:scale-105 transition-transform">
        🌊
      </div>
      <div>
        <div class="text-lg font-black tracking-tight text-slate-900 leading-none flex items-center gap-1">
          Paranacito<span class="text-sky-600">Noticias</span>
          <svg class="w-4 h-4 text-sky-500 fill-current inline-block" viewBox="0 0 24 24" title="Oficial">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
          </svg>
        </div>
        <div class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider mt-0.5">
          Feed Social Comunitario
        </div>
      </div>
    </a>

    <!-- Acciones -->
    <div class="flex items-center gap-2">
      <a 
        href="/redactor"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-900 text-white text-xs font-bold hover:bg-slate-800 transition-colors shadow-sm cursor-pointer"
        title="Publicar o editar posts"
      >
        <span>✍️ Publicar</span>
      </a>
    </div>

  </div>

</header>
