---
import climaData from '../../../data/clima_actual.json';

const { rio } = climaData;
const categorias = [
  { nombre: 'Todas', href: '/' },
  { nombre: 'Río y Clima', href: '/categoria/rio-y-clima' },
  { nombre: 'Comunidad', href: '/categoria/comunidad' },
  { nombre: 'Deportes', href: '/categoria/deportes' },
  { nombre: 'Obras y Servicios', href: '/categoria/obras-y-servicios' },
  { nombre: 'Turismo', href: '/categoria/turismo-y-cultura' },
  { nombre: 'Salud', href: '/categoria/salud-y-educacion' }
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200">
  
  <!-- Barra Superior: Fecha, Altura Rápida y Localidad -->
  <div class="bg-slate-900 text-slate-300 text-xs py-1.5 px-4">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-1">📍 <strong>Villa Paranacito</strong>, Entre Ríos</span>
        <span class="hidden sm:inline text-slate-500">•</span>
        <span class="hidden sm:inline">Delta del Paraná / Río Uruguay</span>
      </div>
      <div class="flex items-center gap-3">
        <a href="/clima" class="inline-flex items-center gap-1.5 bg-sky-950 text-sky-300 px-2 py-0.5 rounded border border-sky-800 hover:bg-sky-900 transition-colors">
          <span>🌊 Río: <strong>{rio.altura_metros}m</strong></span>
          <span class="text-[10px]">({rio.tendencia})</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Cabecera Principal -->
  <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between gap-4">
    
    <!-- Logotipo y Nombre -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-11 h-11 rounded-2xl bg-river-600 flex items-center justify-center text-white shadow-md shadow-river-600/20 group-hover:scale-105 transition-transform">
        <svg class="w-6 h-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 15c3-2 6 2 9 0s6-2 9 0M3 9c3-2 6 2 9 0s6-2 9 0" />
        </svg>
      </div>
      <div>
        <div class="text-xl md:text-2xl font-black tracking-tight text-slate-900 group-hover:text-river-600 transition-colors">
          Paranacito<span class="text-river-600">Noticias</span>
        </div>
        <div class="text-[11px] font-medium text-slate-500 tracking-wide uppercase">
          Portal Informativo Comunitario del Delta
        </div>
      </div>
    </a>

    <!-- Acciones Rápidas -->
    <div class="flex items-center gap-2">
      <a 
        href="/clima"
        class="hidden md:inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-sky-50 text-sky-800 border border-sky-200 text-xs font-semibold hover:bg-sky-100 transition-colors"
      >
        <span>📊 Altura del Río y Clima</span>
      </a>

      <!-- Botón Menú Mobile -->
      <button 
        id="mobile-menu-btn" 
        class="md:hidden p-2 rounded-xl text-slate-600 hover:bg-slate-100 border border-slate-200"
        aria-label="Abrir menú de navegación"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Barra de Navegación por Categorías -->
  <nav class="border-t border-slate-100 hidden md:block">
    <div class="max-w-6xl mx-auto px-4 flex items-center gap-1 overflow-x-auto py-1">
      {categorias.map((cat) => {
        const isActive = currentPath === cat.href || (cat.href !== '/' && currentPath.startsWith(cat.href));
        return (
          <a
            href={cat.href}
            class={`px-3.5 py-2 text-xs font-semibold rounded-lg whitespace-nowrap transition-colors ${
              isActive
                ? 'bg-river-50 text-river-700 font-bold'
                : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
            }`}
          >
            {cat.nombre}
          </a>
        );
      })}
    </div>
  </nav>

  <!-- Menú Desplegable Mobile -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 py-3 space-y-1">
    {categorias.map((cat) => (
      <a
        href={cat.href}
        class="block px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 rounded-lg"
      >
        {cat.nombre}
      </a>
    ))}
    <div class="pt-2 border-t border-slate-100">
      <a
        href="/clima"
        class="block px-3 py-2 text-sm font-bold text-sky-700 bg-sky-50 rounded-lg"
      >
        🌊 Estado del Río y Pronóstico Extendido
      </a>
    </div>
  </div>

</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
