---
/**
 * EventTimeline.astro — Línea de Tiempo de Actualizaciones de una Noticia Viva
 * Muestra la cronología de cómo evolucionó un acontecimiento a medida
 * que distintas fuentes aportaron información.
 */

interface Update {
  hora: string;
  fecha: string;
  fuente: string;
  dato: string;
  es_dato_nuevo?: boolean;
}

interface Props {
  actualizaciones: Update[];
  estado: string;
}

const { actualizaciones = [], estado = "Publicado" } = Astro.props;

if (actualizaciones.length <= 1) {
  // Si solo hay un hito (el inicial), no mostramos la línea de tiempo
  return;
}

const isEnDesarrollo = estado === "En desarrollo";
---

<section class="my-8 bg-slate-50 border border-slate-200 rounded-2xl p-5 md:p-6">

  <div class="flex items-center gap-2.5 mb-5">
    <div class={`w-2.5 h-2.5 rounded-full ${isEnDesarrollo ? 'bg-amber-500 animate-pulse' : 'bg-emerald-500'}`}></div>
    <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider">
      {isEnDesarrollo ? '📡 Noticia en desarrollo — Cronología de actualizaciones' : '📋 Historial de actualizaciones'}
    </h3>
    <span class={`ml-auto text-[11px] font-bold px-2.5 py-0.5 rounded-full border ${
      isEnDesarrollo
        ? 'bg-amber-50 text-amber-700 border-amber-200'
        : 'bg-emerald-50 text-emerald-700 border-emerald-200'
    }`}>
      {isEnDesarrollo ? 'En desarrollo' : 'Cerrado'}
    </span>
  </div>

  <div class="relative pl-6 space-y-5">
    <!-- Línea vertical -->
    <div class="absolute left-2 top-1 bottom-1 w-px bg-slate-300"></div>

    {actualizaciones.map((update, idx) => (
      <div class="relative">
        <!-- Punto en la línea -->
        <div class={`absolute -left-[18px] top-1 w-3 h-3 rounded-full border-2 border-white shadow-sm ${
          idx === actualizaciones.length - 1 && isEnDesarrollo
            ? 'bg-amber-500 animate-pulse'
            : idx === 0
            ? 'bg-river-600'
            : 'bg-slate-400'
        }`}></div>

        <div class="bg-white rounded-xl border border-slate-200 p-3.5 shadow-sm">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-2">
            <span class="text-xs font-black text-slate-800">{update.hora} hs</span>
            <span class="text-slate-300">•</span>
            <span class="text-xs text-slate-500">{update.fecha}</span>
            <span class="text-slate-300">•</span>
            <span class="text-[11px] font-semibold text-river-600 bg-river-50 px-2 py-0.5 rounded-full border border-river-100">
              {update.fuente}
            </span>
            {idx === 0 && (
              <span class="text-[11px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full border border-slate-200">
                Primer reporte
              </span>
            )}
          </div>
          <p class="text-sm text-slate-700 leading-relaxed">{update.dato}</p>
        </div>
      </div>
    ))}

    {isEnDesarrollo && (
      <div class="relative">
        <div class="absolute -left-[18px] top-1 w-3 h-3 rounded-full border-2 border-white bg-amber-200 animate-pulse"></div>
        <div class="bg-amber-50 rounded-xl border border-amber-200 p-3 text-xs text-amber-700 font-medium italic">
          Seguimos monitoreando. Esta noticia puede recibir actualizaciones.
        </div>
      </div>
    )}
  </div>

</section>
