---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PWAInstaller from '../components/PWAInstaller.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = 'Paranacito Noticias | Feed en Vivo del Delta',
  description = 'Últimas noticias de Villa Paranacito, Ceibas y el Delta Entrerriano. Estado del río, pronóstico del clima y novedades comunitarias verificadas.',
  image = '/images/default-paranacito.jpg',
  type = 'website'
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://paranacito-noticias.vercel.app');
const ogImageUrl = image.startsWith('http') ? image : new URL(image, canonicalUrl).href;
---

<!doctype html>
<html lang="es" class="bg-slate-50 text-slate-900 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- PWA Configuración -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0284c7" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Paranacito Noticias" />

    <!-- SEO Básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / WhatsApp / Facebook Sharing -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Paranacito Noticias" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Analítica Web Privada $0 (Cloudflare Web Analytics / Umami opcional) -->
    <!-- Descomentar y colocar tu Token de Cloudflare cuando desees activar analíticas 100% gratis: -->
    <!-- <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "TU_TOKEN_CLOUDFLARE"}'></script> -->

  </head>
  <body class="min-h-screen flex flex-col justify-between">

    <!-- Toast Flotante de Conexión Offline / Online para Isleños del Delta -->
    <div id="offline-toast" class="hidden fixed top-3 left-1/2 -translate-x-1/2 z-50 px-4 py-2 rounded-full text-xs font-bold shadow-lg border transition-all duration-300 flex items-center gap-2 bg-slate-900/95 text-amber-300 border-amber-500/30 backdrop-blur-sm">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      <span id="offline-toast-text">📡 Modo sin conexión • Mostrando noticias guardadas</span>
    </div>

    <Header />
    <main class="flex-grow max-w-6xl w-full mx-auto px-4 py-6">
      <slot />
    </main>
    <Footer />
    <PWAInstaller />

    <!-- Registro de Service Worker para soporte offline PWA -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').then((reg) => {
            console.log('SW registrado con éxito:', reg.scope);
          }).catch((err) => {
            console.log('Error registrando SW:', err);
          });
        });
      }

      // Detector de estado de red (Offline / Online)
      const toast = document.getElementById('offline-toast');
      const toastText = document.getElementById('offline-toast-text');

      function updateOnlineStatus() {
        if (!navigator.onLine) {
          if (toast && toastText) {
            toastText.textContent = '📡 Modo sin conexión • Mostrando noticias guardadas';
            toast.className = 'fixed top-3 left-1/2 -translate-x-1/2 z-50 px-4 py-2 rounded-full text-xs font-bold shadow-lg border transition-all duration-300 flex items-center gap-2 bg-slate-900/95 text-amber-300 border-amber-500/30 backdrop-blur-sm';
            toast.classList.remove('hidden');
          }
        } else {
          if (toast && !toast.classList.contains('hidden')) {
            toastText!.textContent = '🟢 Conexión restablecida';
            toast.className = 'fixed top-3 left-1/2 -translate-x-1/2 z-50 px-4 py-2 rounded-full text-xs font-bold shadow-lg border transition-all duration-300 flex items-center gap-2 bg-emerald-950/95 text-emerald-300 border-emerald-500/30 backdrop-blur-sm';
            setTimeout(() => {
              toast.classList.add('hidden');
            }, 3000);
          }
        }
      }

      window.addEventListener('online', updateOnlineStatus);
      window.addEventListener('offline', updateOnlineStatus);
      if (!navigator.onLine) updateOnlineStatus();
    </script>
  </body>
</html>
